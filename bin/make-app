#!/usr/bin/env bash
# make-app — build Hayflick.app, a macOS Dock launcher for the viewer.
#
# The bundle wraps target/release/viewer: its executable is a tiny script
# that cds to this repo and execs the built binary (the gym level).
# The pixel icon is generated here (64x64 art,
# nearest-upscaled to 1024 — the game's own aesthetic) and packed to .icns
# with sips/iconutil. Re-run after moving the repo; the app is a generated
# artifact (gitignored), the recipe is this script.
#
#   bin/make-app            # (re)build Hayflick.app at the repo root
set -euo pipefail
cd "$(dirname "$0")/.."
ROOT="$(pwd)"
APP="$ROOT/Hayflick.app"

rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"

# ---- launcher: resolve the repo from the bundle location, exec the binary
cat > "$APP/Contents/MacOS/Hayflick" <<'LAUNCH'
#!/bin/bash
# Hayflick.app launcher — the bundle lives at the repo root, so the repo is
# three levels up. exec keeps the pid: the running game keeps the Dock icon.
DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$DIR"
BIN=target/release/viewer
if [ ! -x "$BIN" ]; then
  osascript -e 'display alert "Hayflick" message "No built viewer found. Run: cargo build --release" as critical' >/dev/null 2>&1
  exit 1
fi
exec "$BIN"
LAUNCH
chmod +x "$APP/Contents/MacOS/Hayflick"

cat > "$APP/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Hayflick</string>
  <key>CFBundleDisplayName</key><string>Hayflick</string>
  <key>CFBundleIdentifier</key><string>games.beztroska.hayflick</string>
  <key>CFBundleVersion</key><string>1.0</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleExecutable</key><string>Hayflick</string>
  <key>CFBundleIconFile</key><string>Hayflick</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>LSMinimumSystemVersion</key><string>12.0</string>
</dict>
</plist>
PLIST

# ---- icon: 64x64 pixel-goo, nearest-upscaled to a 1024 master, then .icns
python3 - "$APP" <<'PY'
import struct, sys, zlib

S = 64  # art resolution; upscaled x16 nearest to keep the game's pixel look


def lerp(a, b, t):
    return tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))


def in_round_rect(x, y, r, inset=0):
    m = S - 1
    if x < inset or y < inset or x > m - inset or y > m - inset:
        return False
    cx = min(max(x, inset + r), m - inset - r)
    cy = min(max(y, inset + r), m - inset - r)
    return (x - cx) ** 2 + (y - cy) ** 2 <= r * r + 1


# goo body: a union of three circles (metaball silhouette)
BLOBS = [(30.0, 38.0, 13.0), (41.0, 33.5, 9.0), (36.0, 40.0, 10.5)]


def blob_depth(x, y):
    # >0 inside; the max over circles approximates the union's inner depth
    return max(r - ((x - cx) ** 2 + (y - cy) ** 2) ** 0.5 for cx, cy, r in BLOBS)


px = [[(0, 0, 0, 0)] * S for _ in range(S)]
for y in range(S):
    for x in range(S):
        if not in_round_rect(x, y, 14):
            continue
        t = y / (S - 1)
        c = lerp((0x20, 0x20, 0x2a), (0x12, 0x12, 0x18), t)  # dark slate tile
        # amber accent: a short warden power-band bar under the blob (the
        # droid's signature), not a full ring — the silhouette stays clean
        if 24 <= x <= 39 and 55 <= y <= 56:
            c = (0xe8, 0xb8, 0x4a)
        d = blob_depth(x, y)
        if d > 0:
            g = lerp((0x8c, 0xff, 0xb0), (0x1d, 0x90, 0x58), min(max((y - 24) / 26, 0.0), 1.0))
            if d < 1.6:
                g = (0x14, 0x63, 0x3e)  # dark green rim
            c = g
        # specular glint
        if (x - 26) ** 2 * 1.6 + (y - 30) ** 2 * 3.0 <= 16 and d > 2.0:
            c = (0xe8, 0xff, 0xf0)
        # eyes
        if (27 <= x <= 28 or 35 <= x <= 36) and 36 <= y <= 39 and d > 2.0:
            c = (0x10, 0x2a, 0x1c)
        px[y][x] = (*c, 255)

K = 16  # nearest upscale to 1024
W = S * K
raw = bytearray()
for y in range(W):
    raw.append(0)
    row = px[y // K]
    for x in range(W):
        raw.extend(row[x // K])


def chunk(tag, data):
    return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data))


png = b"\x89PNG\r\n\x1a\n"
png += chunk(b"IHDR", struct.pack(">IIBBBBB", W, W, 8, 6, 0, 0, 0))
png += chunk(b"IDAT", zlib.compress(bytes(raw), 9))
png += chunk(b"IEND", b"")
open(sys.argv[1] + "/icon1024.png", "wb").write(png)
PY

ICONSET="$APP/Hayflick.iconset"
mkdir -p "$ICONSET"
for s in 16 32 128 256 512; do
  sips -z $s $s "$APP/icon1024.png" --out "$ICONSET/icon_${s}x${s}.png" >/dev/null
  d=$((s * 2))
  sips -z $d $d "$APP/icon1024.png" --out "$ICONSET/icon_${s}x${s}@2x.png" >/dev/null
done
iconutil -c icns "$ICONSET" -o "$APP/Contents/Resources/Hayflick.icns"
rm -rf "$ICONSET" "$APP/icon1024.png"

# freshen the bundle so Finder/Dock pick up the icon
touch "$APP"
echo "built $APP"
echo "pin it: drag Hayflick.app onto the Dock (or right-click the running icon -> Options -> Keep in Dock)"
