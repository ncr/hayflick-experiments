#!/usr/bin/env bash
# Golden-frame regression check for the rt-probe deterministic renderer.
#
#   bin/golden            # render house/lab/grid, compare against checked-in goldens
#   bin/golden --update   # regenerate the goldens (after an INTENTIONAL look change)
#
# The renderer is bit-stable (shade.comp is a pure function of scene + camera;
# LIGHT_ANIM=0 freezes the practicals), so a byte-compare of the PNGs is the
# whole test. Goldens live in native/rt-probe/golden/ and are MACHINE-SPECIFIC
# (GPU + driver shade exact float behaviour): regenerate after a driver update
# if all fail identically.
#
# Five goldens: house / lab / grid (the legacy scenes), plus the SCENE=game
# greybox content scene at its spawn state (game) and at the end of the
# checked-in CMDS replay trace (game_replay — door open, score 2, lights off;
# the SHOT-mode wall clock never ticks the sim, so this is a pure function of
# the scene + the trace). CMDS replay is byte-reproducible and matches the
# house-game replay_game_golden state_hash.
#
# SHOT runs FULLY headless (no window, no surface, no swapchain) — WINDOW
# pins the offscreen capture extent exactly, so golden dimensions are
# reproducible with no window manager in the loop.
set -euo pipefail
cd "$(dirname "$0")/.."

# Goldens are MACHINE-SPECIFIC (GPU + driver exact float behaviour) AND
# BACKEND-specific: the Vulkan (NVIDIA) and Metal (Apple Silicon) paths produce
# different floats, so each keeps its own set. GOLDEN_DIR selects which — the
# default is the Vulkan set; the M2 Pro uses
# `GOLDEN_DIR=native/rt-probe/golden-metal bin/golden`.
GOLD="${GOLDEN_DIR:-native/rt-probe/golden}"
OUT="${TMPDIR:-/tmp}/rt-golden"
UPDATE="${1:-}"

cargo build --release --manifest-path native/Cargo.toml
mkdir -p "$OUT" "$GOLD"

GAME_TRACE=native/crates/house-game/traces/replay_game.txt

fail=0
for s in house lab grid game game_replay; do
  case "$s" in
    game)        SCENE=game WINDOW=1024x640 LIGHT_ANIM=0 SHOT="$OUT/$s.png" ./native/target/release/viewer >/dev/null 2>&1 ;;
    game_replay) SCENE=game WINDOW=1024x640 LIGHT_ANIM=0 CMDS="$GAME_TRACE" SHOT="$OUT/$s.png" ./native/target/release/viewer >/dev/null 2>&1 ;;
    *)           SCENE=$s WINDOW=1024x640 LIGHT_ANIM=0 SHOT="$OUT/$s.png" ./native/target/release/viewer >/dev/null 2>&1 ;;
  esac
  if [ "$UPDATE" = "--update" ]; then
    cp "$OUT/$s.png" "$GOLD/$s.png"
    # portable byte count (GNU stat -c%s vs BSD/macOS stat -f%z differ)
    echo "golden updated: $s ($(wc -c < "$GOLD/$s.png" | tr -d ' ') bytes)"
  elif [ ! -f "$GOLD/$s.png" ]; then
    echo "MISS $s — no golden yet (run bin/golden --update)"
    fail=1
  elif cmp -s "$OUT/$s.png" "$GOLD/$s.png"; then
    echo "OK   $s"
  else
    echo "FAIL $s — differs from $GOLD/$s.png (candidate kept at $OUT/$s.png)"
    fail=1
  fi
done
exit $fail
