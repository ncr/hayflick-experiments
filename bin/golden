#!/usr/bin/env bash
# Golden-frame gate — SUSPENDED during the joyful-visual reset (Faza 0/1).
#
# The old golden sets (house/lab/grid/game/... on Vulkan AND Metal) were
# deleted with their scenes in the 2026-07-12 purge (git tag
# archive/pre-joyful-reset). During Faza 1 every change is EXPECTED to move
# pixels (projection generalization + the joyful look search), so a byte gate
# would only generate noise.
#
# The gate comes back the moment the owner locks the Faza-1 look: pin a town
# frame per machine/backend (SHOT= + WINDOW=, LIGHT_ANIM=0) and restore the
# byte-compare loop from git history (bin/golden @ archive/pre-joyful-reset).
#
# Until then the render check for a change is:
#   cargo test                    # the headless suite (always binding)
#   WINDOW=1024x640 SHOT=/tmp/a.png ./target/release/viewer   # before
#   ...change...
#   WINDOW=1024x640 SHOT=/tmp/b.png ./target/release/viewer   # after
#   compare -metric AE /tmp/a.png /tmp/b.png null:            # intentional?
echo "bin/golden: SUSPENDED — goldens return after the Faza-1 look lock (see docs/VISION.md)."
echo "Use 'cargo test' + before/after SHOT diffs to verify render changes."
exit 0
