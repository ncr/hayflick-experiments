#!/usr/bin/env bash
# Build and run the viewer (deterministic hardware-RT renderer).
#
#   bin/run               # the gym: one hand-authored level (a few walls,
#                         # one building, the player — docs/VISION.md)
#   AO_R=1.2 bin/run      # every Config env knob passes through (config.rs)
#   LOOK=polana bin/run   # seed/validate the boot look (look.rs; polana is
#                         # the only look since the 2026-07-12 owner lock)
#
# The GI bake is cached on disk, so re-launches are instant
# (PROBE_CACHE=0 to disable, =<dir> to relocate).
#
# The owner plays from the IN-GAME menus (docs/VISION.md): ESC opens the
# game menu (resume / restart / settings / quit); SETTINGS has the live
# sliders and prints the reproducing env string on close.
#
# 'r' records a clip (game-pixel capture): stop writes clips/clip_NNNN.mp4
# AND .gif. Knobs: CLIP_FPS=50 CLIP_MP4_SCALE=4 CLIP_GIF_SCALE=1 CLIP_MAX_S=60.
# 'l' toggles the lamps. q/e rotate, scroll/+- zoom, 0 resets the camera.
#
# The viewer must run from the repo root (asset paths) — this script cd's
# there itself, so it works from anywhere.
set -euo pipefail

cd "$(dirname "$0")/.."

cargo build --release --manifest-path Cargo.toml

exec ./target/release/viewer
