#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require

// World-space irradiance probe BAKE — the only place Monte Carlo lives in the
// deterministic render mode. Each probe path-traces a deterministic batch of
// spherical-Fibonacci directions and accumulates incident radiance into a
// 6-axis ambient cube (HL2 style). The cache lives in WORLD space, so camera
// motion can never invalidate it: it converges once at load and is then
// frozen, which is what makes the per-frame shade pass (shade.comp) a pure
// deterministic function of (scene, camera).
//
// Double-count contract with shade.comp: probe rays NEVER count emissive
// surfaces seen directly (the pixel samples lights itself via NEE); they DO
// evaluate direct sun + NEE light at every hit (that is 1+ bounce light by the
// time it reaches a pixel) and count sky on miss (pixels never sample sky).
//
// The dynamic player instance carries TLAS mask 0x05 and probe rays cull with
// 0x0A, so the movable player neither occludes nor bounces in the baked cache
// (its shadows come from the per-pixel deterministic shadow rays instead) —
// the cache stays valid as it walks.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;

struct Vertex { vec3 pos; vec3 nrm; vec2 uv; };
struct GeomInfo { uint indexOffset; uint vertexOffset; int materialId; uint pad; };
struct Material { vec4 baseColor; vec4 emissive; float metallic; float roughness; int texIndex; int pad; };

layout(set = 0, binding = 2, scalar) readonly buffer Verts { Vertex verts[]; };
layout(set = 0, binding = 3, scalar) readonly buffer Indices { uint indices[]; };
layout(set = 0, binding = 4, scalar) readonly buffer Geoms { GeomInfo geoms[]; };
layout(set = 0, binding = 5, scalar) readonly buffer Mats { Material mats[]; };
layout(set = 0, binding = 6) uniform sampler2D textures[];
struct Light { vec4 posRad; vec4 color; vec4 dir; };
layout(set = 0, binding = 7, scalar) readonly buffer Lights { Light lights[]; };
// Probe field: 16-float header [origin.xyz, spacing, dims.xyz, _] then per
// probe 20 floats: 6 axis faces (+X,-X,+Y,-Y,+Z,-Z) x rgb sums, ray count, pad.
layout(set = 0, binding = 11, scalar) buffer Probes { float pd[]; };

layout(push_constant) uniform Push {
  vec4 camRight; vec4 camUp; vec4 camDir; vec4 camPos; // unused (bake has no camera)
  ivec4 misc;  // probeCount, raysTotal (Fibonacci N), bounces, raysThisBatch
  ivec4 misc2; // batchStartRay, _, _, lightCount
  vec4 env0;   // sunScale, skyScale, fogDensity, fogHeight
} pc;

// probe rays ignore the dynamic player (bit 0x04 absent) but DO hit
// dollhouse-hidden walls (0x02) — baked light transport is yaw-invariant
const uint PROBE_MASK = 0x0Au;

uint hash(uint x){x^=x>>16;x*=0x7feb352dU;x^=x>>15;x*=0x846ca68bU;x^=x>>16;return x;}
float rnd(inout uint s){s=hash(s);return float(s)*(1.0/4294967296.0);}

vec3 sky(vec3 d){
  float t = clamp(d.y * 0.5 + 0.5, 0.0, 1.0);
  vec3 horizon = vec3(0.80, 0.83, 0.90);
  vec3 zenith  = vec3(0.28, 0.45, 0.92);
  vec3 ground  = vec3(0.14, 0.13, 0.12);
  return (d.y > 0.0 ? mix(horizon, zenith, pow(t, 1.4)) : mix(horizon, ground, clamp(-d.y * 3.0, 0.0, 1.0))) * 0.18 * pc.env0.y;
}

struct Hit { float t; vec3 n; vec2 uv; int mat; };

bool trace(vec3 o, vec3 dir, float tmax, out Hit h){
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, PROBE_MASK, o, 0.001, dir, tmax);
  while (rayQueryProceedEXT(rq)) {}
  if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) return false;
  h.t = rayQueryGetIntersectionTEXT(rq, true);
  int gi = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);
  uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
  vec2 bc = rayQueryGetIntersectionBarycentricsEXT(rq, true);
  float b0 = 1.0 - bc.x - bc.y, b1 = bc.x, b2 = bc.y;
  GeomInfo g = geoms[gi];
  uint i0 = indices[g.indexOffset + prim * 3u + 0u] + g.vertexOffset;
  uint i1 = indices[g.indexOffset + prim * 3u + 1u] + g.vertexOffset;
  uint i2 = indices[g.indexOffset + prim * 3u + 2u] + g.vertexOffset;
  Vertex v0 = verts[i0], v1 = verts[i1], v2 = verts[i2];
  h.n = normalize(b0 * v0.nrm + b1 * v1.nrm + b2 * v2.nrm);
  h.uv = b0 * v0.uv + b1 * v1.uv + b2 * v2.uv;
  h.mat = g.materialId;
  return true;
}

bool occluded(vec3 o, vec3 dir, float tmax){
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, PROBE_MASK, o, 0.001, dir, tmax);
  while (rayQueryProceedEXT(rq)) {}
  return rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

// Incident radiance along (o, d) — the trace.comp bounce loop minus camera
// concerns: no fog, no G-buffers, and emissive surfaces NEVER count directly
// (shade.comp's per-pixel NEE owns direct light; adding it here would double).
vec3 radiance(vec3 o, vec3 d, uint seed){
  int bounces = pc.misc.z;
  vec3 sunDir = normalize(vec3(0.62, 0.55, 0.38));
  vec3 sun = vec3(1.0, 0.88, 0.70) * 6.0 * pc.env0.x;
  vec3 thru = vec3(1.0), col = vec3(0.0);
  for (int b = 0; b <= bounces; b++) {
    Hit h;
    if (!trace(o, d, 300.0, h)) { col += thru * sky(d); break; }
    Material m = mats[h.mat];
    vec3 albedo = m.baseColor.rgb;
    if (m.texIndex >= 0) albedo *= texture(textures[nonuniformEXT(m.texIndex)], h.uv).rgb;
    vec3 n = h.n; if (dot(n, d) > 0.0) n = -n;
    vec3 p = o + h.t * d + n * 0.003;

    float ndl = max(dot(n, sunDir), 0.0);
    if (pc.env0.x > 0.0 && ndl > 0.0 && !occluded(p, sunDir, 200.0)) col += thru * albedo * sun * ndl;

    int lc = pc.misc2.w;
    if (lc > 0) {
      const int NEE_S = 4;
      float lw = float(lc) / float(NEE_S);
      for (int ls = 0; ls < NEE_S; ls++) {
        int li = clamp(int(rnd(seed) * float(lc)), 0, lc - 1);
        Light lt = lights[li];
        vec3 toL = lt.posRad.xyz - p;
        float dist = max(length(toL), 1e-4);
        if (dist <= lt.posRad.w) continue;
        vec3 ldir = toL / dist;
        float ndl2 = dot(n, ldir);
        if (ndl2 <= 0.0) continue;
        float emit = lt.dir.w > 0.0 ? 2.0 * max(dot(-ldir, lt.dir.xyz), 0.0) : 1.0;
        if (emit <= 0.0) continue;
        float sinT = clamp(lt.posRad.w / dist, 0.0, 1.0);
        float omega = 6.2831853 * (1.0 - sqrt(1.0 - sinT * sinT));
        if (!occluded(p, ldir, dist - lt.posRad.w)) {
          vec3 c = thru * albedo * (1.0 / 3.14159265) * lt.color.rgb * ndl2 * omega * lw * emit;
          col += min(c, vec3(2.5)); // firefly clamp: probes feed EVERY pixel they cover
        }
      }
    }

    // diffuse continuation only — the cache stores irradiance (speculars are a
    // per-pixel concern; the matte iso look barely has them)
    thru *= albedo;
    vec3 t1 = normalize(abs(n.y) < 0.99 ? cross(n, vec3(0, 1, 0)) : cross(n, vec3(1, 0, 0)));
    vec3 t2 = cross(n, t1);
    float r1 = rnd(seed), r2 = rnd(seed);
    float phi = 6.2831853 * r1, sr = sqrt(r2), cz = sqrt(1.0 - r2);
    d = normalize(t1 * cos(phi) * sr + t2 * sin(phi) * sr + n * cz);
    o = p;
    if (max(thru.r, max(thru.g, thru.b)) < 0.02) break;
  }
  return col;
}

void main(){
  uint pi = gl_GlobalInvocationID.x;
  if (pi >= uint(pc.misc.x)) return;
  vec3 origin = vec3(pd[0], pd[1], pd[2]);
  float spacing = pd[3];
  int nx = int(pd[4]), ny = int(pd[5]);
  ivec3 g = ivec3(int(pi) % nx, (int(pi) / nx) % ny, int(pi) / (nx * ny));
  vec3 P = origin + vec3(g) * spacing;
  uint base = 16u + pi * 20u;

  vec3 sums[6];
  for (int f = 0; f < 6; f++) sums[f] = vec3(pd[base + f * 3u], pd[base + f * 3u + 1u], pd[base + f * 3u + 2u]);
  float count = pd[base + 18u];

  int N = pc.misc.y;
  for (int k = 0; k < pc.misc.w; k++) {
    int ri = pc.misc2.x + k;
    if (ri >= N) break;
    // spherical Fibonacci direction ri of N — a fixed, deterministic set:
    // re-running the bake reproduces the cache bit-for-bit
    float zc = 1.0 - (2.0 * float(ri) + 1.0) / float(N);
    float phi = 6.2831853 * fract(float(ri) * 0.6180339887);
    float rr = sqrt(max(0.0, 1.0 - zc * zc));
    vec3 d = vec3(rr * cos(phi), zc, rr * sin(phi));
    vec3 L = radiance(P, d, hash(pi * 9781u + uint(ri) * 6271u + 1u));
    // ambient-cube projection: E_axis sums L * cos+ against each axis
    sums[0] += L * max( d.x, 0.0); sums[1] += L * max(-d.x, 0.0);
    sums[2] += L * max( d.y, 0.0); sums[3] += L * max(-d.y, 0.0);
    sums[4] += L * max( d.z, 0.0); sums[5] += L * max(-d.z, 0.0);
    count += 1.0;
  }

  for (int f = 0; f < 6; f++) {
    pd[base + f * 3u] = sums[f].x;
    pd[base + f * 3u + 1u] = sums[f].y;
    pd[base + f * 3u + 2u] = sums[f].z;
  }
  pd[base + 18u] = count;
}
