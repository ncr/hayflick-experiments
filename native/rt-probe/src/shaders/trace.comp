#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require

// Textured path tracer over a GLTF scene. Geometry is in world space (one BLAS
// per primitive, identity instances); the hit's primitive + barycentrics fetch
// interpolated world normal + UV, and the material's base-colour texture is
// sampled from a bindless array. HDR radiance is accumulated additively.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba32f) uniform image2D accumImg;

struct Vertex { vec3 pos; vec3 nrm; vec2 uv; };
struct GeomInfo { uint indexOffset; uint vertexOffset; int materialId; uint pad; };
struct Material { vec4 baseColor; vec4 emissive; float metallic; float roughness; int texIndex; int pad; };

layout(set = 0, binding = 2, scalar) readonly buffer Verts { Vertex verts[]; };
layout(set = 0, binding = 3, scalar) readonly buffer Indices { uint indices[]; };
layout(set = 0, binding = 4, scalar) readonly buffer Geoms { GeomInfo geoms[]; };
layout(set = 0, binding = 5, scalar) readonly buffer Mats { Material mats[]; };
layout(set = 0, binding = 6) uniform sampler2D textures[];

layout(push_constant) uniform Push {
  vec4 camRight; vec4 camUp; vec4 camDir; vec4 camPos;
  ivec4 misc;  // W, H, bounces, spp
  ivec4 misc2; // seed, debugAlbedo, aaJitter
} pc;

uint hash(uint x){x^=x>>16;x*=0x7feb352dU;x^=x>>15;x*=0x846ca68bU;x^=x>>16;return x;}
float rnd(inout uint s){s=hash(s);return float(s)*(1.0/4294967296.0);}

vec3 sky(vec3 d){
  float t = clamp(d.y * 0.5 + 0.5, 0.0, 1.0);
  vec3 horizon = vec3(0.80, 0.83, 0.90);
  vec3 zenith  = vec3(0.28, 0.45, 0.92);
  vec3 ground  = vec3(0.14, 0.13, 0.12);
  return (d.y > 0.0 ? mix(horizon, zenith, pow(t, 1.4)) : mix(horizon, ground, clamp(-d.y * 3.0, 0.0, 1.0))) * 0.18;
}

struct Hit { float t; vec3 n; vec2 uv; int mat; };

bool trace(vec3 o, vec3 dir, float tmax, out Hit h){
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0xFF, o, 0.001, dir, tmax);
  while (rayQueryProceedEXT(rq)) {}
  if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) return false;
  h.t = rayQueryGetIntersectionTEXT(rq, true);
  int gi = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);
  uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
  vec2 bc = rayQueryGetIntersectionBarycentricsEXT(rq, true);
  float b0 = 1.0 - bc.x - bc.y, b1 = bc.x, b2 = bc.y;
  GeomInfo g = geoms[gi];
  uint i0 = indices[g.indexOffset + prim * 3u + 0u] + g.vertexOffset;
  uint i1 = indices[g.indexOffset + prim * 3u + 1u] + g.vertexOffset;
  uint i2 = indices[g.indexOffset + prim * 3u + 2u] + g.vertexOffset;
  Vertex v0 = verts[i0], v1 = verts[i1], v2 = verts[i2];
  h.n = normalize(b0 * v0.nrm + b1 * v1.nrm + b2 * v2.nrm);
  h.uv = b0 * v0.uv + b1 * v1.uv + b2 * v2.uv;
  h.mat = g.materialId;
  return true;
}

bool occluded(vec3 o, vec3 dir, float tmax){
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xFF, o, 0.001, dir, tmax);
  while (rayQueryProceedEXT(rq)) {}
  return rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

void main(){
  int W = pc.misc.x, H = pc.misc.y;
  ivec2 px = ivec2(gl_GlobalInvocationID.xy);
  if (px.x >= W || px.y >= H) return;
  int bounces = pc.misc.z, spp = pc.misc.w;
  uint seed = hash(uint(px.x) * 1973u + uint(px.y) * 9277u + uint(pc.misc2.x) * 26699u + 1u);

  vec3 sunDir = normalize(vec3(0.62, 0.55, 0.38)); // lower angle -> long, readable shadows
  vec3 sun = vec3(1.0, 0.88, 0.70) * 6.0;          // dominant warm key; sky fill kept dim for contrast

  vec3 sum = vec3(0.0);
  for (int s = 0; s < spp; s++) {
    // Primary rays go through the pixel CENTRE by default (deterministic):
    // each low-res pixel is then a binary geometry sample, exactly like the
    // web raster path with MSAA off — edges keep the hard 2:1 pixel
    // staircase that defines the game look. Randomness stays in the bounce
    // directions only (lighting converges, geometry never blurs).
    // misc2.z = 1 restores sub-pixel jitter (photoreal AA, softens pixels).
    float jx = 0.5, jy = 0.5;
    if (pc.misc2.z == 1) { jx = rnd(seed); jy = rnd(seed); }
    float u = ((float(px.x) + jx) / float(W)) * 2.0 - 1.0;
    float v = ((float(px.y) + jy) / float(H)) * 2.0 - 1.0; v = -v;
    vec3 o = pc.camPos.xyz + u * pc.camRight.w * pc.camRight.xyz + v * pc.camUp.w * pc.camUp.xyz;
    vec3 d = normalize(pc.camDir.xyz);

    vec3 thru = vec3(1.0), col = vec3(0.0);
    for (int b = 0; b <= bounces; b++) {
      Hit h;
      if (!trace(o, d, 300.0, h)) { col += thru * sky(d); break; }
      Material m = mats[h.mat];
      vec3 albedo = m.baseColor.rgb;
      if (m.texIndex >= 0) albedo *= texture(textures[nonuniformEXT(m.texIndex)], h.uv).rgb;
      if (pc.misc2.y == 1) { col += albedo; break; } // debug: raw base-colour
      vec3 n = h.n; if (dot(n, d) > 0.0) n = -n;
      vec3 p = o + h.t * d + n * 0.003;

      col += thru * m.emissive.rgb;

      float ndl = max(dot(n, sunDir), 0.0);
      if (ndl > 0.0 && !occluded(p, sunDir, 200.0)) col += thru * albedo * sun * ndl;

      vec3 t1 = normalize(abs(n.y) < 0.99 ? cross(n, vec3(0, 1, 0)) : cross(n, vec3(1, 0, 0)));
      vec3 t2 = cross(n, t1);
      float specProb = mix(0.04, 1.0, m.metallic);
      if (rnd(seed) < specProb) {
        vec3 r = reflect(d, n);
        float a = m.roughness * m.roughness;
        float r1 = rnd(seed), r2 = rnd(seed);
        vec3 jit = (t1 * (r1 - 0.5) + t2 * (r2 - 0.5)) * a * 1.6;
        d = normalize(r + jit);
        if (dot(d, n) < 0.0) d = r;
        thru *= mix(vec3(1.0), albedo, m.metallic);
      } else {
        thru *= albedo;
        float r1 = rnd(seed), r2 = rnd(seed);
        float phi = 6.2831853 * r1, sr = sqrt(r2), cz = sqrt(1.0 - r2);
        d = normalize(t1 * cos(phi) * sr + t2 * sin(phi) * sr + n * cz);
      }
      o = p;
      if (max(thru.r, max(thru.g, thru.b)) < 0.02) break;
    }
    sum += col;
  }

  vec3 prev = imageLoad(accumImg, px).rgb;
  imageStore(accumImg, px, vec4(prev + sum, 1.0));
}
