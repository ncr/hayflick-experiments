#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require

// Textured path tracer over a GLTF scene. Geometry is in world space (one BLAS
// per primitive, identity instances); the hit's primitive + barycentrics fetch
// interpolated world normal + UV, and the material's base-colour texture is
// sampled from a bindless array.
//
// Accumulation is a per-pixel RUNNING MEAN: rgb holds mean radiance, alpha the
// sample count. Per-pixel counts (instead of one global divisor) are what let
// the viewer shift the converged buffer on whole-pixel camera pans and clear
// only the rect a moving prop touched — shifted pixels keep their convergence,
// fresh ones restart at zero, and every consumer reads radiance directly with
// no division. The count is capped so a pixel never goes fully stale: new
// samples always keep at least 1/COUNT_CAP weight (heals e.g. a shadow edge
// the rect invalidation under-covered, within ~COUNT_CAP/spp frames).

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba32f) uniform image2D accumImg;

struct Vertex { vec3 pos; vec3 nrm; vec2 uv; };
struct GeomInfo { uint indexOffset; uint vertexOffset; int materialId; uint pad; };
struct Material { vec4 baseColor; vec4 emissive; float metallic; float roughness; int texIndex; int pad; };

layout(set = 0, binding = 2, scalar) readonly buffer Verts { Vertex verts[]; };
layout(set = 0, binding = 3, scalar) readonly buffer Indices { uint indices[]; };
layout(set = 0, binding = 4, scalar) readonly buffer Geoms { GeomInfo geoms[]; };
layout(set = 0, binding = 5, scalar) readonly buffer Mats { Material mats[]; };
layout(set = 0, binding = 6) uniform sampler2D textures[];
// Emissive practicals as NEE lights: bounding sphere (xyz, radius) + radiance.
// Count rides in pc.misc2.w (0 = no list bound beyond the dummy entry).
struct Light { vec4 posRad; vec4 color; vec4 dir; }; // dir: mean surface normal (w=1) or isotropic (w=0)
layout(set = 0, binding = 7, scalar) readonly buffer Lights { Light lights[]; };
// Primary-hit G-buffers — OIDN denoise guides (albedo + shading normal).
// Written once per dispatch from the first sample's primary hit. With AA off
// the primary ray is the deterministic pixel centre, so these are NOISE-FREE
// (cleanAux): the denoiser preserves texture/edges and only smooths lighting.
layout(set = 0, binding = 8, rgba32f) uniform image2D albedoImg;
layout(set = 0, binding = 9, rgba32f) uniform image2D normalImg;
layout(set = 0, binding = 10, rgba32f) uniform image2D posImg; // primary-hit world position (w=1 hit, 0 miss) — history reprojection

layout(push_constant) uniform Push {
  vec4 camRight; vec4 camUp; vec4 camDir; vec4 camPos;
  ivec4 misc;  // W, H, bounces, spp
  ivec4 misc2; // seed, debugAlbedo, aaJitter, lightCount
  vec4 env0;   // sunScale, skyScale, fogDensity, fogHeight (wu falloff)
} pc;

// Cap matches the viewer's MAX_SAMPLES idle gate: noise decreases MONOTONICALLY
// until dispatch stops (no perpetual random-walk at a fixed floor, which read
// as shimmer-then-sudden-freeze). Stale under-invalidated pixels still heal,
// just over ~1-2 s of motion instead of a fraction of one.
const float COUNT_CAP = 4096.0;

uint hash(uint x){x^=x>>16;x*=0x7feb352dU;x^=x>>15;x*=0x846ca68bU;x^=x>>16;return x;}
float rnd(inout uint s){s=hash(s);return float(s)*(1.0/4294967296.0);}

vec3 sky(vec3 d){
  float t = clamp(d.y * 0.5 + 0.5, 0.0, 1.0);
  vec3 horizon = vec3(0.80, 0.83, 0.90);
  vec3 zenith  = vec3(0.28, 0.45, 0.92);
  vec3 ground  = vec3(0.14, 0.13, 0.12);
  return (d.y > 0.0 ? mix(horizon, zenith, pow(t, 1.4)) : mix(horizon, ground, clamp(-d.y * 3.0, 0.0, 1.0))) * 0.18 * pc.env0.y;
}

// Optical depth of the exponential ground mist sigma(y) = D * exp(-y / H)
// along o + s*d for s in [0, t] (closed form; caller keeps y >= 0 on the
// segment so the exponential never blows up).
float fogOD(vec3 o, vec3 d, float t){
  float D = pc.env0.z, H = pc.env0.w;
  if (abs(d.y) < 1e-4) return D * exp(-o.y / H) * t;
  return D * (H / d.y) * (exp(-o.y / H) - exp(-(o.y + d.y * t) / H));
}

struct Hit { float t; vec3 n; vec2 uv; int mat; };

// `mask`: 0x01 for PRIMARY rays (skips dollhouse-hidden walls so the camera
// sees inside), 0xFF for bounce rays (hidden walls still block + bounce light
// so the room stays enclosed; the lighting must rotate with the WORLD).
bool trace(vec3 o, vec3 dir, float tmax, uint mask, out Hit h){
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, mask, o, 0.001, dir, tmax);
  while (rayQueryProceedEXT(rq)) {}
  if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) return false;
  h.t = rayQueryGetIntersectionTEXT(rq, true);
  int gi = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);
  uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
  vec2 bc = rayQueryGetIntersectionBarycentricsEXT(rq, true);
  float b0 = 1.0 - bc.x - bc.y, b1 = bc.x, b2 = bc.y;
  GeomInfo g = geoms[gi];
  uint i0 = indices[g.indexOffset + prim * 3u + 0u] + g.vertexOffset;
  uint i1 = indices[g.indexOffset + prim * 3u + 1u] + g.vertexOffset;
  uint i2 = indices[g.indexOffset + prim * 3u + 2u] + g.vertexOffset;
  Vertex v0 = verts[i0], v1 = verts[i1], v2 = verts[i2];
  h.n = normalize(b0 * v0.nrm + b1 * v1.nrm + b2 * v2.nrm);
  h.uv = b0 * v0.uv + b1 * v1.uv + b2 * v2.uv;
  h.mat = g.materialId;
  return true;
}

bool occluded(vec3 o, vec3 dir, float tmax){
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xFF, o, 0.001, dir, tmax);
  while (rayQueryProceedEXT(rq)) {}
  return rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

void main(){
  int W = pc.misc.x, H = pc.misc.y;
  ivec2 px = ivec2(gl_GlobalInvocationID.xy);
  if (px.x >= W || px.y >= H) return;
  int bounces = pc.misc.z, spp = pc.misc.w;
  uint seed = hash(uint(px.x) * 1973u + uint(px.y) * 9277u + uint(pc.misc2.x) * 26699u + 1u);

  vec3 sunDir = normalize(vec3(0.62, 0.55, 0.38)); // lower angle -> long, readable shadows
  vec3 sun = vec3(1.0, 0.88, 0.70) * 6.0 * pc.env0.x; // dominant warm key; sky fill kept dim for contrast

  vec3 sum = vec3(0.0);
  for (int s = 0; s < spp; s++) {
    // Primary rays go through the pixel CENTRE by default (deterministic):
    // each low-res pixel is then a binary geometry sample, exactly like the
    // web raster path with MSAA off — edges keep the hard 2:1 pixel
    // staircase that defines the game look. Randomness stays in the bounce
    // directions only (lighting converges, geometry never blurs).
    // misc2.z = 1 restores sub-pixel jitter (photoreal AA, softens pixels).
    float jx = 0.5, jy = 0.5;
    if (pc.misc2.z == 1) { jx = rnd(seed); jy = rnd(seed); }
    float u = ((float(px.x) + jx) / float(W)) * 2.0 - 1.0;
    float v = ((float(px.y) + jy) / float(H)) * 2.0 - 1.0; v = -v;
    vec3 o = pc.camPos.xyz + u * pc.camRight.w * pc.camRight.xyz + v * pc.camUp.w * pc.camUp.xyz;
    vec3 d = normalize(pc.camDir.xyz);

    vec3 thru = vec3(1.0), col = vec3(0.0);
    bool fromSpec = true; // camera and mirror chains see emissive surfaces directly
    for (int b = 0; b <= bounces; b++) {
      Hit h;
      bool hitb = trace(o, d, 300.0, b == 0 ? 0x01u : 0xFFu, h);
      // Exponential ground mist on the PRIMARY segment only: attenuate what
      // lies beyond it, add ambient inscatter, and estimate the single-scatter
      // sun term with one sample per path (noise converges with accumulation).
      // Fog never moves the hit — it re-weights radiance smoothly — so pixel
      // edges stay binary (the pixel-look invariant holds).
      if (b == 0 && pc.env0.z > 0.0 && pc.misc2.y == 0) {
        // cap the segment at the y=0 plane so the exponential stays bounded
        // (a miss would otherwise integrate unbounded depth below the void)
        float tseg = hitb ? h.t : min(300.0, o.y / max(-d.y, 1e-4));
        float T = exp(-fogOD(o, d, tseg));
        vec3 fogCol = vec3(0.55, 0.58, 0.66) * 0.18 * pc.env0.y;
        // sun shaft: sample only the last stretch of the segment — that's
        // where the height-falloff mist actually lives
        float L = min(tseg, 8.0 * pc.env0.w / max(-d.y, 0.05));
        float ts = tseg - rnd(seed) * L;
        vec3 ps = o + d * ts;
        float ss = pc.env0.z * exp(-max(ps.y, 0.0) / pc.env0.w);
        vec3 shaft = vec3(0.0);
        if (pc.env0.x > 0.0 && ss > 1e-5 && !occluded(ps, sunDir, 200.0))
          shaft = sun * ss * exp(-fogOD(o, d, ts)) * L * 0.08; // ~isotropic phase
        col += thru * (fogCol * (1.0 - T) + shaft);
        thru *= T;
      }
      if (!hitb) {
        if (s == 0 && b == 0) { // G-buffer: sky miss
          imageStore(albedoImg, px, vec4(1.0));
          imageStore(normalImg, px, vec4(0.0));
          imageStore(posImg, px, vec4(0.0));
        }
        col += thru * sky(d);
        break;
      }
      Material m = mats[h.mat];
      vec3 albedo = m.baseColor.rgb;
      if (m.texIndex >= 0) albedo *= texture(textures[nonuniformEXT(m.texIndex)], h.uv).rgb;
      if (pc.misc2.y == 1) { col += albedo; break; } // debug: raw base-colour
      vec3 n = h.n; if (dot(n, d) > 0.0) n = -n;
      if (s == 0 && b == 0) { // G-buffer: primary-hit denoise guides + position
        imageStore(albedoImg, px, vec4(albedo, 1.0));
        imageStore(normalImg, px, vec4(n, 0.0));
        imageStore(posImg, px, vec4(o + h.t * d, 1.0));
      }
      vec3 p = o + h.t * d + n * 0.003;

      // Emission counts only when the light is seen directly or via a mirror
      // chain (fromSpec); diffuse paths get it through NEE below instead —
      // adding both would double-count.
      if (fromSpec) col += thru * m.emissive.rgb;

      float ndl = max(dot(n, sunDir), 0.0);
      if (pc.env0.x > 0.0 && ndl > 0.0 && !occluded(p, sunDir, 200.0)) col += thru * albedo * sun * ndl;

      vec3 t1 = normalize(abs(n.y) < 0.99 ? cross(n, vec3(0, 1, 0)) : cross(n, vec3(1, 0, 0)));
      vec3 t2 = cross(n, t1);
      float specProb = mix(0.04, 1.0, m.metallic);

      // NEE: sample a few practicals per hit (uniform picks, x count/samples
      // to unbias). Solid-angle weight of each light's bounding sphere;
      // diffuse lobe only (specular paths find lights via fromSpec emission).
      // Shadow rays are cheap here (~0.6ms frames) — 4 samples kills most of
      // the 1-of-N selection variance that makes lamp pools speckle.
      int lc = pc.misc2.w;
      if (lc > 0) {
        const int NEE_S = 4;
        float lw = float(lc) / float(NEE_S);
        for (int ls = 0; ls < NEE_S; ls++) {
          int li = clamp(int(rnd(seed) * float(lc)), 0, lc - 1);
          Light lt = lights[li];
          vec3 toL = lt.posRad.xyz - p;
          float dist = max(length(toL), 1e-4);
          if (dist <= lt.posRad.w) continue;
          vec3 ldir = toL / dist;
          float ndl2 = dot(n, ldir);
          if (ndl2 <= 0.0) continue;
          // one-sided Lambertian emitters: a screen/panel lights its facing
          // hemisphere (cosine), not the space behind it. x2 keeps the frontal
          // pool near the old isotropic level.
          float emit = lt.dir.w > 0.0 ? 2.0 * max(dot(-ldir, lt.dir.xyz), 0.0) : 1.0;
          if (emit <= 0.0) continue;
          float sinT = clamp(lt.posRad.w / dist, 0.0, 1.0);
          float omega = 6.2831853 * (1.0 - sqrt(1.0 - sinT * sinT));
          if (!occluded(p, ldir, dist - lt.posRad.w)) {
            vec3 c = thru * (1.0 - specProb) * albedo * (1.0 / 3.14159265)
                   * lt.color.rgb * ndl2 * omega * lw * emit;
            // firefly clamp on INDIRECT lamp hits: a bounce ray landing right
            // next to a lamp gets a huge solid angle through `thru`; clamping
            // those rare spikes trades a hair of GI energy for fast convergence
            if (b > 0) c = min(c, vec3(2.5));
            col += c;
          }
        }
      }

      if (rnd(seed) < specProb) {
        vec3 r = reflect(d, n);
        float a = m.roughness * m.roughness;
        float r1 = rnd(seed), r2 = rnd(seed);
        vec3 jit = (t1 * (r1 - 0.5) + t2 * (r2 - 0.5)) * a * 1.6;
        d = normalize(r + jit);
        if (dot(d, n) < 0.0) d = r;
        thru *= mix(vec3(1.0), albedo, m.metallic);
        fromSpec = true;
      } else {
        fromSpec = false;
        thru *= albedo;
        float r1 = rnd(seed), r2 = rnd(seed);
        float phi = 6.2831853 * r1, sr = sqrt(r2), cz = sqrt(1.0 - r2);
        d = normalize(t1 * cos(phi) * sr + t2 * sin(phi) * sr + n * cz);
      }
      o = p;
      if (max(thru.r, max(thru.g, thru.b)) < 0.02) break;
    }
    sum += col;
  }

  vec4 prev = imageLoad(accumImg, px);
  float n = min(prev.a, COUNT_CAP);
  float nn = n + float(spp);
  imageStore(accumImg, px, vec4((prev.rgb * n + sum) / nn, nn));
}
