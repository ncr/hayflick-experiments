#version 460

// Resolve the HDR accumulation buffer to an 8-bit window image, doing the
// pixel-perfect integer-NEAREST upscale on the GPU: one low-res texel maps to a
// scale×scale block of output pixels. `pan` shifts which low-res texel sits
// under a given output pixel (in whole low-res pixels — carried remainder lives
// on the CPU side, so this stays integer and crisp). Output pixels that fall
// outside the low-res buffer get a neutral background (overscan guard band).
//
// Stylized post stack, applied per LOW-RES texel (one game pixel = one post
// sample, so the pixel-look invariant holds; the upscale only repeats values):
//   tonemap -> grade -> film grain -> ordered-dither palette quantize
// Everything is deterministic per (texel, frame) — no temporal shimmer beyond
// the intentional animated grain. The CPU capture path in viewer.rs
// (capture_denoised) mirrors this stack EXACTLY — keep them in sync.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D accumImg;
layout(set = 0, binding = 1, rgba8)   uniform writeonly image2D outImg;

layout(push_constant) uniform Push {
  ivec4 dims; // low_w, low_h, out_w, out_h
  ivec4 cfg;  // scale, samples, pan_x, pan_y  (pan in low-res pixels)
  vec4  fcfg; // exposure, grain strength, frame, flags (bit0 grade, bit1 palette)
} pc;

float luma(vec3 c){ return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

// Fallout-ish grade: desaturate a touch, split-tone teal shadows / amber
// highlights, soft lift, gentle s-curve. Mirrored in lib.rs post_grade().
vec3 grade(vec3 g){
  float y = luma(g);
  g = mix(g, vec3(y), 0.22);
  g += vec3(0.04, 0.10, 0.10) * (1.0 - y) * 0.55
     + vec3(0.10, 0.06, -0.04) * y * 0.55;
  g = g * 0.92 + 0.02;
  g = clamp(g, 0.0, 1.0);
  vec3 s = g * g * (3.0 - 2.0 * g);
  return clamp(mix(g, s, 0.35), 0.0, 1.0);
}

uint hashu(uint x){ x^=x>>16; x*=0x7feb352dU; x^=x>>15; x*=0x846ca68bU; x^=x>>16; return x; }

// 8x8 Bayer threshold matrix, centred to [-0.5, 0.5)
const float BAYER[64] = float[64](
   0., 32.,  8., 40.,  2., 34., 10., 42., 48., 16., 56., 24., 50., 18., 58., 26.,
  12., 44.,  4., 36., 14., 46.,  6., 38., 60., 28., 52., 20., 62., 30., 54., 22.,
   3., 35., 11., 43.,  1., 33.,  9., 41., 51., 19., 59., 27., 49., 17., 57., 25.,
  15., 47.,  7., 39., 13., 45.,  5., 37., 63., 31., 55., 23., 61., 29., 53., 21.);

// Hand-designed 32-colour palette (gamma space): teal shadow ramp, olive
// midtones, lamp amber, bone highlights + terminal/rust/hazard/grass accents.
// Mirrored in lib.rs PALETTE32 — keep in sync.
const vec3 PAL[32] = vec3[32](
  vec3(0.0196, 0.0235, 0.0314), vec3(0.0510, 0.0549, 0.0784),
  vec3(0.0824, 0.0941, 0.1373), vec3(0.1137, 0.1412, 0.2000),
  vec3(0.1529, 0.2039, 0.2784), vec3(0.1961, 0.2118, 0.1686),
  vec3(0.2588, 0.2745, 0.2275), vec3(0.3333, 0.3529, 0.2784),
  vec3(0.4157, 0.4392, 0.3373), vec3(0.5137, 0.5373, 0.4078),
  vec3(0.6157, 0.6392, 0.4941), vec3(0.2275, 0.1647, 0.1098),
  vec3(0.3608, 0.2549, 0.1569), vec3(0.5216, 0.3608, 0.2000),
  vec3(0.6902, 0.4902, 0.2549), vec3(0.8392, 0.6431, 0.3373),
  vec3(0.9490, 0.8118, 0.5412), vec3(0.7098, 0.7020, 0.6039),
  vec3(0.8157, 0.8039, 0.7059), vec3(0.9098, 0.8941, 0.8118),
  vec3(0.9804, 0.9647, 0.9020), vec3(0.1137, 0.2902, 0.2902),
  vec3(0.1843, 0.4784, 0.4314), vec3(0.3216, 0.7686, 0.6588),
  vec3(0.2902, 0.1137, 0.1137), vec3(0.5412, 0.2000, 0.1529),
  vec3(0.7608, 0.3373, 0.2118), vec3(0.6510, 0.4157, 0.1216),
  vec3(0.8784, 0.6039, 0.1686), vec3(0.1647, 0.2118, 0.1333),
  vec3(0.2667, 0.3294, 0.1882), vec3(0.3961, 0.4667, 0.2902));

void main(){
  ivec2 o = ivec2(gl_GlobalInvocationID.xy);
  if (o.x >= pc.dims.z || o.y >= pc.dims.w) return;
  int scale = max(pc.cfg.x, 1);

  // output pixel -> low-res source texel (+ whole-pixel pan)
  ivec2 lp = o / scale + ivec2(pc.cfg.z, pc.cfg.w);

  vec3 col;
  if (lp.x < 0 || lp.y < 0 || lp.x >= pc.dims.x || lp.y >= pc.dims.y) {
    col = vec3(0.05, 0.05, 0.06); // guard band
  } else {
    float samples = max(float(pc.cfg.y), 1.0);
    vec3 hdr = imageLoad(accumImg, lp).rgb / samples * pc.fcfg.x;
    col = hdr / (hdr + vec3(1.0));          // Reinhard
    col = pow(col, vec3(1.0 / 2.2));        // gamma

    int flags = int(pc.fcfg.w);
    if ((flags & 1) != 0) col = grade(col);

    // animated film grain, per game pixel, luminance-weighted toward shadows
    if (pc.fcfg.y > 0.0) {
      uint h = hashu(uint(lp.x) * 1973u + uint(lp.y) * 9277u + uint(pc.fcfg.z) * 26699u + 1u);
      float g = float(h) * (1.0 / 4294967296.0) - 0.5;
      col += g * pc.fcfg.y * (0.35 + 0.65 * (1.0 - luma(col)));
      col = clamp(col, 0.0, 1.0);
    }

    // ordered-dither quantize to the fixed palette (grain above feeds the
    // dither, so residual path-trace noise reads as palette sparkle)
    if ((flags & 2) != 0) {
      float bay = (BAYER[(lp.x & 7) + (lp.y & 7) * 8] + 0.5) / 64.0 - 0.5;
      vec3 c2 = clamp(col + bay * 0.07, 0.0, 1.0);
      float best = 1e9;
      vec3 bc = c2;
      for (int i = 0; i < 32; i++) {
        vec3 dd = PAL[i] - c2;
        float d2 = dot(dd, dd);
        if (d2 < best) { best = d2; bc = PAL[i]; }
      }
      col = bc;
    }
  }
  imageStore(outImg, o, vec4(clamp(col, 0.0, 1.0), 1.0));
}
