{
  "name": "@apps/hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "forge:retrofit-colliders": "node scripts/retrofit-collider-meshes.mjs",
    "forge:precompute-colliders": "node scripts/precompute-vhacd-colliders.mjs --preset=Balanced",
    "forge-v2:precompute-colliders": "node scripts/precompute-vhacd-colliders-v2.mjs",
    "forge:precompute-static-collider": "node scripts/precompute-static-asset-collider.mjs"
  },
  "dependencies": {
    "@common/collider-vhacd": "workspace:*",
    "@common/render": "workspace:^",
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@experiments/catalog": "workspace:*",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@types/three": "^0.173.0",
    "meshoptimizer": "^1.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.4.1",
    "vite": "^6.1.0",
    "vite-plugin-glsl": "^1.3.1"
  }
}
