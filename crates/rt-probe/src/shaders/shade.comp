#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require

// DETERMINISTIC per-frame ray-traced shade — the web-renderer stability
// contract, kept under ray tracing. The image is a PURE FUNCTION of
// (scene, camera): one primary ray through each pixel centre, deterministic
// shadow rays to the sun and to every significant light, and a lookup into
// the world-space irradiance probe cache (probes.comp) for GI. No random
// numbers anywhere in this shader -> a fixed camera gives a bit-identical
// image every frame, and every frame of a rotation sweep is exactly as
// "converged" as the settled frame. No accumulation, no denoiser, no
// temporal anything.
//
// Double-count contract with probes.comp: this pass owns direct light
// (emissive seen by camera, sun NEE, light NEE) — the probe cache owns
// everything indirect (1+ bounce light + sky), and never counts emissive
// surfaces seen directly.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba32f) uniform image2D colorImg; // radiance out (a=1; tonemap reads rgb directly)

struct Vertex { vec3 pos; vec3 nrm; vec2 uv; };
struct GeomInfo { uint indexOffset; uint vertexOffset; int materialId; uint pad; };
struct Material { vec4 baseColor; vec4 emissive; float metallic; float roughness; int texIndex; int pad; };

layout(set = 0, binding = 2, scalar) readonly buffer Verts { Vertex verts[]; };
layout(set = 0, binding = 3, scalar) readonly buffer Indices { uint indices[]; };
layout(set = 0, binding = 4, scalar) readonly buffer Geoms { GeomInfo geoms[]; };
layout(set = 0, binding = 5, scalar) readonly buffer Mats { Material mats[]; };
layout(set = 0, binding = 6) uniform sampler2D textures[];
struct Light { vec4 posRad; vec4 color; vec4 dir; };
layout(set = 0, binding = 7, scalar) readonly buffer Lights { Light lights[]; };
layout(set = 0, binding = 8, rgba32f) uniform image2D albedoImg; // primary-hit albedo (tonemap demodulation)
layout(set = 0, binding = 9, rgba32f) uniform image2D posImg;    // primary-hit world position (tonemap outline; w=0: sky)
layout(set = 0, binding = 10, scalar) readonly buffer Probes { float pd[]; };

// Mirrors render::ShadePush — field-for-field.
layout(push_constant) uniform Push {
  vec4 camRight; vec4 camUp; vec4 camDir; vec4 camPos; // camDir.w = AO radius, camPos.w = AO strength
  ivec4 misc;  // W, H, aoRays, debug (0 off, 1 albedo, 2 probe GI, 3 direct only, 4 AO term)
  ivec4 misc2; // roomLights dim 16.16 fixed point (probe-bank lerp), lightCount, reflBlockPx, floorCutY 16.16 (INT_MAX = off)
  vec4 env0;   // sunScale, skyScale, fogDensity, fogHeight
  vec4 roi;    // CAVE_ROI: player world xyz, w = disc radius (low-res px)
  vec4 roi2;   // projected player px.xy, z = disc falloff px, w = enabled (>0.5)
  vec4 look;   // spec strength, bump strength, bump scale (wu^-1), gloss (0..1)
  vec4 look2;  // gi scale, matPoster levels, aoDither, reflStrength
  ivec4 misc3; // wallCutY 16.16 (INT_MAX = off; occluder-only sill cut), _, _, _
  vec4 env1;   // sun/sky-as-data (Faza 1b): sun dir xyz (normalized), w = ground tint r
  vec4 env2;   // sun tint rgb, w = ground tint g
  vec4 env3;   // sky horizon tint rgb, w = ground tint b
  vec4 env4;   // sky zenith tint rgb, _
} pc;

// 4x4 ordered-Bayer threshold in [0,1) for a screen lattice cell — the shade-pass
// twin of tonemap.comp's `ditherAt` mode 2 (same matrix, shifted from its centred
// [-0.5,0.5) range into [0,1) so it compares directly against a [0,1] coverage).
float bayer4(ivec2 lp){
  const float B[16] = float[16](0.,8.,2.,10., 12.,4.,14.,6., 3.,11.,1.,9., 15.,7.,13.,5.);
  return (B[(lp.x & 3) + (lp.y & 3) * 4] + 0.5) / 16.0;
}

// ---- CONTOUR COVERAGE AA (owner 2026-07-25) --------------------------------
// Everything below the gate is the ORDINARY shade kernel: a coverage tap is the
// SAME kernel re-dispatched with a fixed sub-pixel ray offset, so the cutaway /
// ROI / glass state machine, the Bayer stipple phase and every material path
// are reused BY IDENTITY, not by a copy.
const float AA_R = 0.42; // px — clears the max tap reach |(24,8)|/64 = 0.3953
const ivec2 AAOFF[5] = ivec2[5](ivec2(0, 0), ivec2(24, 8), ivec2(-8, 24), ivec2(-24, -8), ivec2(8, -24));

// Is this texel a CONTOUR — i.e. may it fire coverage taps?
// Two independent gates, both cheap and both purely geometric:
//  1. EDGE PROXIMITY: its own primary hit, or a 4-neighbour's (dilation catches
//     the background side of a silhouette, whose own hit has no near edge),
//     lies within AA_R screen px of a gating triangle edge (albedoImg.a).
//  2. NON-PLANARITY: the primary-hit position field is locally NON-affine.
//     Under the ORTHO camera the hit position is exactly affine inside a planar
//     facet, so a coplanar tiling seam — the grass grid, panel seams, the crack
//     veneer's CLOSED seams — has a zero second difference and is NOT a
//     contour: it fires nothing and stays bit-identical. A silhouette, a crease
//     and a crevice all bend or break the field.
bool aaGate(ivec2 px, int W, int H) {
  const ivec2 N4[4] = ivec2[4](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));
  ivec2 hi = ivec2(W - 1, H - 1);
  float e = imageLoad(albedoImg, px).a;
  for (int k = 0; k < 4; k++) e = min(e, imageLoad(albedoImg, clamp(px + N4[k], ivec2(0), hi)).a);
  if (e >= AA_R) return false;
  vec4 P0 = imageLoad(posImg, px);
  if (P0.w == 0.0) return true; // sky texel: the far side of a silhouette
  float tol = 0.6 * (2.0 * pc.camRight.w / float(W)); // 0.6 px, in wu
  for (int k = 0; k < 2; k++) {
    ivec2 o = k == 0 ? ivec2(1, 0) : ivec2(0, 1);
    vec4 Pa = imageLoad(posImg, clamp(px + o, ivec2(0), hi));
    vec4 Pb = imageLoad(posImg, clamp(px - o, ivec2(0), hi));
    if (Pa.w == 0.0 || Pb.w == 0.0) return true;
    if (length(Pa.xyz + Pb.xyz - 2.0 * P0.xyz) > tol) return true;
  }
  return false;
}

// A tap folds into the texel's running mean: colorImg carries rgb = sum(w*L),
// a = sum(w). The centre pass stores a = 1, so an unresolved texel divides by
// exactly 1 — every reader must divide by .a when .a > 1 (there are two:
// tonemap's radiance load and its bloom tap).
void aaAccum(ivec2 px, float w, vec3 c) {
  vec4 a = imageLoad(colorImg, px);
  imageStore(colorImg, px, vec4(a.rgb + w * c, a.a + w));
}

vec3 sky(vec3 d){
  float t = clamp(d.y * 0.5 + 0.5, 0.0, 1.0);
  vec3 horizon = pc.env3.rgb; // look-authored (sun/sky-as-data, Faza 1b)
  vec3 zenith  = pc.env4.rgb;
  vec3 ground  = vec3(pc.env1.w, pc.env2.w, pc.env3.w); // look-authored void tint
  return (d.y > 0.0 ? mix(horizon, zenith, pow(t, 1.4)) : mix(horizon, ground, clamp(-d.y * 3.0, 0.0, 1.0))) * 0.18 * pc.env0.y;
}

float fogOD(vec3 o, vec3 d, float t){
  float D = pc.env0.z, H = pc.env0.w;
  if (abs(d.y) < 1e-4) return D * exp(-o.y / H) * t;
  return D * (H / d.y) * (exp(-o.y / H) - exp(-(o.y + d.y * t) / H));
}

// `edge` = world distance from the hit point to the nearest GATING triangle
// edge (see trace) — the contour-AA gate's raw signal.
struct Hit { float t; vec3 n; vec2 uv; int mat; float edge; };

bool trace(vec3 o, vec3 dir, float tmax, uint mask, out Hit h){
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, mask, o, 0.001, dir, tmax);
  while (rayQueryProceedEXT(rq)) {}
  if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) return false;
  h.t = rayQueryGetIntersectionTEXT(rq, true);
  int gi = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);
  uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
  vec2 bc = rayQueryGetIntersectionBarycentricsEXT(rq, true);
  float b0 = 1.0 - bc.x - bc.y, b1 = bc.x, b2 = bc.y;
  GeomInfo g = geoms[gi];
  uint i0 = indices[g.indexOffset + prim * 3u + 0u] + g.vertexOffset;
  uint i1 = indices[g.indexOffset + prim * 3u + 1u] + g.vertexOffset;
  uint i2 = indices[g.indexOffset + prim * 3u + 2u] + g.vertexOffset;
  Vertex v0 = verts[i0], v1 = verts[i1], v2 = verts[i2];
  h.n = normalize(b0 * v0.nrm + b1 * v1.nrm + b2 * v2.nrm);
  h.uv = b0 * v0.uv + b1 * v1.uv + b2 * v2.uv;
  h.mat = g.materialId;
  // CONTOUR AA (owner 2026-07-25): distance to the nearest triangle edge, in
  // world units — d_i = b_i * (2A / |e_i|) for the edge opposite vertex i. The
  // triangle's LONGEST edge is EXCLUDED: every quad this codebase emits
  // (add_box faces, add_floor, the crack veneer's plates, chamfer bands and
  // prism walls) is a rectangle split by its diagonal, and the diagonal is the
  // strictly longest side of both halves — so the triangulation artefact never
  // gates and flat faces stay bit-identical. ALU only: v0/v1/v2 are already
  // resident, and occluded()/aoVis() are separate functions that pay nothing.
  vec3 E0 = v2.pos - v1.pos, E1 = v0.pos - v2.pos, E2 = v1.pos - v0.pos;
  float L0 = length(E0), L1 = length(E1), L2 = length(E2);
  float A2 = length(cross(E2, -E1));
  float Lm = max(L0, max(L1, L2));
  h.edge = min(L0 >= Lm ? 1e9 : A2 * b0 / max(L0, 1e-6),
           min(L1 >= Lm ? 1e9 : A2 * b1 / max(L1, 1e-6),
               L2 >= Lm ? 1e9 : A2 * b2 / max(L2, 1e-6)));
  return true;
}

bool occluded(vec3 o, vec3 dir, float tmax){
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xFF, o, 0.001, dir, tmax);
  while (rayQueryProceedEXT(rq)) {}
  return rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

// AO visibility with linear distance falloff: 1 on miss, t/R on a hit within
// range R (first-hit t, not nearest — slight over-darkening, fine for AO).
float aoVis(vec3 o, vec3 dir, float R){
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xFF, o, 0.001, dir, R);
  while (rayQueryProceedEXT(rq)) {}
  if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) return 1.0;
  return clamp(rayQueryGetIntersectionTEXT(rq, true) / R, 0.0, 1.0);
}

// Deterministic short-range RT ambient occlusion at (p, n): a FIXED
// cosine-hemisphere ray set (spherical-Fibonacci, oriented by a world-space
// tangent frame derived from n only) — no randomness, so a fixed camera stays
// bit-identical and the term is rotation-invariant. Rays use mask 0xFF: the
// player and the walls both occlude, which grounds the player (the probe cache
// deliberately ignores it) and keeps the term yaw-invariant. Walls are solid in
// the TLAS — the CAVE_ROI see-through is a primary-ray-only effect.
float rtAO(vec3 p, vec3 n, int N, float R, float strength){
  vec3 t1 = normalize(abs(n.y) < 0.99 ? cross(n, vec3(0.0, 1.0, 0.0)) : cross(n, vec3(1.0, 0.0, 0.0)));
  vec3 t2 = cross(n, t1);
  float vis = 0.0;
  for (int i = 0; i < N; i++) {
    float u = (float(i) + 0.5) / float(N);
    float r = sqrt(u);
    float ph = 6.2831853 * fract(float(i) * 0.6180339887);
    vec3 d = t1 * (r * cos(ph)) + t2 * (r * sin(ph)) + n * sqrt(max(1.0 - u, 0.0));
    vis += aoVis(p, d, R);
  }
  return mix(1.0, vis / float(N), strength);
}

// Irradiance at (p, n) from the ambient-cube probe grid: trilinear over the 8
// surrounding probes, each evaluated HL2-style (n^2-weighted axis faces). The
// sample point is pushed off the surface so probes buried in the wall behind
// a surface contribute less.
//
// The cache holds TWO banks (probes.comp): bank 0 = practicals off (sun/sky
// only), bank 1 = full. Light transport is linear in emission, so lerping the
// banks by the room-lights dim (misc2.x, 16.16 fixed point) is EXACT at every
// level — no re-bake on a light switch.
vec3 axisFaces(uint b0, uint b1, uint off, float lerp_){
  return mix(vec3(pd[b0 + off], pd[b0 + off + 1u], pd[b0 + off + 2u]),
             vec3(pd[b1 + off], pd[b1 + off + 1u], pd[b1 + off + 2u]), lerp_);
}
vec3 probeE(vec3 p, vec3 n){
  vec3 origin = vec3(pd[0], pd[1], pd[2]);
  float spacing = pd[3];
  ivec3 dims = ivec3(int(pd[4]), int(pd[5]), int(pd[6]));
  uint bankStride = uint(dims.x * dims.y * dims.z) * 20u;
  float lerp_ = float(pc.misc2.x) / 65536.0;
  vec3 f = (p + n * (0.3 * spacing) - origin) / spacing;
  f = clamp(f, vec3(0.0), vec3(dims) - 1.001);
  ivec3 i0 = ivec3(floor(f));
  vec3 t = f - vec3(i0);
  vec3 n2 = n * n;
  vec3 e = vec3(0.0);
  float wsum = 0.0;
  for (int c = 0; c < 8; c++) {
    ivec3 ic = i0 + ivec3(c & 1, (c >> 1) & 1, (c >> 2) & 1);
    vec3 w3 = mix(1.0 - t, t, vec3(ic - i0));
    float w = w3.x * w3.y * w3.z;
    if (w <= 1e-5) continue;
    uint pi = uint(ic.x + ic.y * dims.x + ic.z * dims.x * dims.y);
    uint base = 16u + pi * 20u;
    uint base1 = base + bankStride;
    float cnt = pd[base + 18u];
    if (cnt < 1.0) continue;
    vec3 fx = n.x > 0.0 ? axisFaces(base, base1, 0u, lerp_) : axisFaces(base, base1, 3u, lerp_);
    vec3 fy = n.y > 0.0 ? axisFaces(base, base1, 6u, lerp_) : axisFaces(base, base1, 9u, lerp_);
    vec3 fz = n.z > 0.0 ? axisFaces(base, base1, 12u, lerp_) : axisFaces(base, base1, 15u, lerp_);
    vec3 E = (n2.x * fx + n2.y * fy + n2.z * fz) * (12.566370 / cnt); // 4pi/N uniform-sphere estimator
    e += w * E;
    wsum += w;
  }
  return wsum > 1e-5 ? e / wsum : vec3(0.0);
}

// ---- aesthetic look helpers (SPEC / BUMP / GLOSS) — all deterministic ----
// Cheap hash-based 3D value noise: a pure function of world position, so the
// surface detail it drives is bit-identical every frame (no temporal shimmer)
// and rotation-invariant. Used only when the look knobs are on; BUMP=0 / SPEC=0
// leave the image byte-for-byte unchanged.
float hash13(vec3 p){
  p = fract(p * 0.1031);
  p += dot(p, p.yzx + 33.33);
  return fract((p.x + p.y) * p.z);
}
float vnoise(vec3 x){
  vec3 i = floor(x), f = fract(x);
  f = f * f * (3.0 - 2.0 * f);
  float n000 = hash13(i + vec3(0,0,0)), n100 = hash13(i + vec3(1,0,0));
  float n010 = hash13(i + vec3(0,1,0)), n110 = hash13(i + vec3(1,1,0));
  float n001 = hash13(i + vec3(0,0,1)), n101 = hash13(i + vec3(1,0,1));
  float n011 = hash13(i + vec3(0,1,1)), n111 = hash13(i + vec3(1,1,1));
  return mix(mix(mix(n000,n100,f.x), mix(n010,n110,f.x), f.y),
             mix(mix(n001,n101,f.x), mix(n011,n111,f.x), f.y), f.z);
}
float fbm(vec3 p){ return 0.65 * vnoise(p) + 0.35 * vnoise(p * 2.03 + 11.1); } // 2 octaves, ~[0,1]

// ---- crack-lab helpers (per-segment aging — see the CRACK LAB block) -------
// 2D cellular (Worley) edge distance on a wall face: the crack NETWORK is the
// cell boundaries. Returns F2-F1 (0 exactly on a boundary); `site` gets the
// vector from p to the nearest cell site (the edge bevel tilts the normal
// along it) and `cellH` the nearest cell's hash (coverage: which cells' rims
// crack at a given age). Pure function of position — deterministic.
vec2 crackSite(vec2 c, float seed){
  return vec2(hash13(vec3(c, seed)), hash13(vec3(c, seed + 47.0)));
}
float crackEdge(vec2 p, float seed, out vec2 site, out float cellH){
  vec2 i = floor(p), f = fract(p);
  float f1 = 8.0, f2 = 8.0;
  vec2 r1 = vec2(0.0), c1 = vec2(0.0);
  for (int y = -1; y <= 1; y++)
    for (int x = -1; x <= 1; x++) {
      vec2 g = vec2(float(x), float(y));
      vec2 r = g + crackSite(i + g, seed) - f;
      float dd = dot(r, r);
      if (dd < f1) { f2 = f1; f1 = dd; r1 = r; c1 = i + g; }
      else if (dd < f2) { f2 = dd; }
    }
  site = r1;
  cellH = hash13(vec3(c1, seed + 91.0));
  return sqrt(f2) - sqrt(f1);
}
// One STRUCTURAL fault lattice on a face plane (u = the face's horizontal
// world coordinate, v = world height): at most one full-height crack per
// 6-wu strip — jagged wander + a per-crack settlement slant, width pinching
// and gaping along the run (anchor + wander stay inside the strip, so no
// cross-strip clipping). Returns the core mask; `halo` the fractured
// surround, `side` which lip of the crack this pixel is on. The SAME
// lattice evaluated with the same (u, v) keys on a wall face and on the
// pier's top cap makes the crack cross the cap — it reads as going
// THROUGH the wall, not painted on one face.
float faultAt(vec2 uv, float seed, float cAge, float cDen, float cDep,
              out float halo, out float side){
  halo = 0.0; side = 0.0;
  float si = floor(uv.x / 6.0);
  float pMaj = 0.95 * smoothstep(0.12, 0.42, cAge) * smoothstep(0.04, 0.45, cDen);
  if (hash13(vec3(si, seed, 71.0)) >= pMaj) return 0.0;
  float ax = (si + mix(0.22, 0.78, hash13(vec3(si, seed, 83.0)))) * 6.0;
  float tilt = (hash13(vec3(si, seed, 97.0)) - 0.5) * 0.8; // settlement slant
  float wob = (vnoise(vec3(uv.y * 0.8, si * 7.3, seed + 17.0)) - 0.5) * 1.3
            + (vnoise(vec3(uv.y * 4.1, si * 7.3, seed + 29.0)) - 0.5) * 0.22;
  float dx = uv.x - (ax + tilt * uv.y + wob);
  float wvar = 0.35 + 1.3 * vnoise(vec3(uv.y * 1.7, si * 3.1, seed + 41.0));
  float mw = mix(0.022, 0.055, cDep) * wvar * (0.55 + 0.45 * cAge);
  halo = 1.0 - smoothstep(mw, mw * 7.0, abs(dx));
  side = sign(dx);
  return 1.0 - smoothstep(mw * 0.35, mw, abs(dx));
}

// Stylized point-light specular: GGX normal-distribution × Schlick-Fresnel, no
// solid-angle or geometry term (SPEC is the master gain). D is clamped so a
// near-mirror highlight stays a soft plateau instead of a single-pixel firefly
// at the low render resolution.
vec3 specBRDF(vec3 n, vec3 v, vec3 l, float reff, vec3 F0){
  vec3 hh = normalize(v + l);
  float ndh = max(dot(n, hh), 0.0);
  float voh = max(dot(v, hh), 0.0);
  float a = max(reff * reff, 1e-3), a2 = a * a;
  float den = ndh * ndh * (a2 - 1.0) + 1.0;
  float D = min(a2 / (3.14159265 * den * den), 40.0);
  vec3 F = F0 + (1.0 - F0) * pow(1.0 - voh, 5.0);
  return D * F;
}

void main(){
  int W = pc.misc.x, H = pc.misc.y;
  ivec2 px = ivec2(gl_GlobalInvocationID.xy);
  if (px.x >= W || px.y >= H) return;

  // CONTOUR AA: misc3.z = tap weight (16.16), misc3.w = sample index. 0 = the
  // centre pass (one ray through the pixel centre — the pixel contract's
  // default); 1..4 = a coverage tap, which exists only on contour texels.
  float aaW = float(pc.misc3.z) * (1.0 / 65536.0);
  int S = pc.misc3.w;
  // S == 5 is the GATE pass: it runs the contour test ONCE and marks every
  // non-contour texel with a negative weight, so each of the four tap passes
  // skips it after a SINGLE load. (Running the test per tap cost 40 buffer
  // loads per texel and doubled the frame; and it cannot be cached in place,
  // because a pass that both reads its neighbours' edge distances and
  // overwrites its own would race — hence a separate channel and a separate
  // dispatch. -1 reads as "one sample" to every consumer: the tonemap divides
  // only when the weight exceeds 1.)
  if (S == 5) {
    vec4 c = imageLoad(colorImg, px);
    if (!aaGate(px, W, H)) imageStore(colorImg, px, vec4(c.rgb, -1.0));
    return;
  }
  if (S > 0) {
    if (pc.misc.w != 0) return;                     // debug views stay centre-only
    if (imageLoad(colorImg, px).a < 0.0) return;    // interiors: not one extra ray
  }

  vec3 sunDir = pc.env1.xyz; // normalized CPU-side (EnvBlock::pack)
  vec3 sun = pc.env2.rgb * 6.0 * pc.env0.x;

  // primary ray through the pixel CENTRE — deterministic, hard pixel edges.
  // The +1/64 px bias is the RT analogue of the rasterizer top-left rule:
  // panel seams sit on the world lattice, which aligns EXACTLY with pixel
  // centres at certain window parities — a ray on the seam plane slips
  // between the two panels' BLASes (watertightness is per-BLAS) and draws a
  // dark vertical crack line. The fixed bias keeps rays off all seam planes
  // at every alignment; 1/64 px is sub-perceptual and constant per frame.
  const float TIE = 1.0 / 64.0;
  // the tap's sub-pixel offset is an EVEN multiple of 1/64, so every tap ray
  // still lands on an ODD multiple of 1/64 — off every dyadic seam plane, which
  // is the whole point of the TIE bias above (a tap must not invent its own
  // BLAS-seam dot-dashes)
  vec2 aaOff = vec2(AAOFF[S]) * (1.0 / 64.0);
  float u = ((float(px.x) + 0.5 + TIE + aaOff.x) / float(W)) * 2.0 - 1.0;
  float v = -(((float(px.y) + 0.5 + TIE + aaOff.y) / float(H)) * 2.0 - 1.0);
  vec3 o = pc.camPos.xyz + u * pc.camRight.w * pc.camRight.xyz + v * pc.camUp.w * pc.camUp.xyz;
  vec3 d = normalize(pc.camDir.xyz);
  vec3 o0 = o; // camera origin, kept for fog / world-distance after a ROI advance

  Hit h;
  bool hitb = trace(o, d, 300.0, 0x01u, h); // primary ray; CAVE_ROI sees through walls per-pixel below

  // FLOORCUT dollhouse (module 11 auto-reveal), two planes:
  // - STOREY cut (misc2.w): EVERY primary-ray hit at or above the plane
  //   dissolves — storeys above the player's floor and their roofs come off
  //   like lifting a dollhouse cap. A deterministic function of the player's
  //   floor (a Y inside the ceiling gap: slabs above go, your floor stays).
  // - WALL cut (misc3.x): only OCCLUDER hits (mats[..].pad bit 1 — walls,
  //   roofs, glass panes) at or above the plane dissolve. The game sets it to
  //   sill height while the player is INDOORS, so buildings open into a
  //   cutaway while bodies, props and door leaves keep their full height.
  // INT_MAX disables a plane; both off skips the block entirely,
  // reproducing the pre-cut image bit-for-bit. The iso camera looks DOWN
  // (d.y < 0), so hit Y decreases monotonically along the ray: one prefix
  // loop suffices, and the CAVE_ROI block below never sees above-cut hits.
  if (pc.misc2.w != 2147483647 || pc.misc3.x != 2147483647) {
    bool storey = pc.misc2.w != 2147483647;
    bool wall = pc.misc3.x != 2147483647;
    float cutY = float(pc.misc2.w) * (1.0 / 65536.0);
    float wallY = float(pc.misc3.x) * (1.0 / 65536.0);
    // wallPass: the previous hit was a wall we are cutting — a nearby
    // occluder hit (h.t <= 0.6, ~one slab thickness) is that slab's FAR
    // face, which may already sit BELOW the plane (walls straddle it);
    // pass through it or its inner surface renders as a dark band along
    // every cut edge (the ROI loop's proven far-face rule, and the
    // AGENT_LEARNINGS floorcut-slab failure mode). GLASS panes (pad bit 2)
    // get a wider far-face bound: they are 0.3 thick and crossed obliquely
    // (up to 0.3/|d.z| ≈ 0.78 wu through a Z-boundary pane at the trimetric
    // d), so the 0.6 bound left the pane's BELOW-PLANE far face rendered as
    // a floating glass plate over every cut window. Gating the 1.0 bound to
    // glass keeps real second walls solid (any parallel occluder is beyond
    // a floor hit, which breaks the loop first).
    // Glass stubs stand 0.3125 taller than wall stubs: the pane is the
    // proudest thing in its bay, so its cut silhouette must COVER the
    // opening's porcelain jamb behind it — same world height but deeper in
    // view, the jamb's cut edge projects higher on screen and would poke
    // out as a thin dark sliver (it sits in the still-solid pane's sun
    // shadow). The taller glass stub also echoes the crown lip motif.
    bool wallPass = false;
    for (int it = 0; it < 16 && hitb; it++) {
      float hy = (o + d * h.t).y;
      bool glass = (mats[h.mat].pad & 2) != 0;
      bool occ = (mats[h.mat].pad & 1) == 1;
      float ffar = glass ? 1.0 : 0.6;
      float wy = glass ? wallY + 0.3125 : wallY;
      bool cut = (storey && hy >= cutY) || (wall && occ && (hy >= wy || (wallPass && h.t <= ffar)));
      if (!cut) break;
      wallPass = occ;
      o = o + d * (h.t + (1.0 / 256.0));
      hitb = trace(o, d, 300.0, 0x01u, h);
    }
  }

  // CAVE_ROI dithered see-through: dissolve occluder-wall hits (mats[h.mat].pad bit 1)
  // that lie BETWEEN the camera and the player AND inside a soft, player-anchored
  // screen disc, by marching the SAME primary ray past them (re-trace, mask 0x01).
  // The far wall (at/behind the player) and everything outside the disc stay
  // solid; the screen-door Bayer keep test makes crisp holes, never alpha. The
  // dither lattice is anchored to the WORLD (see wpx below) so the stipple stays
  // glued to the scene as the player walks, rather than riding with the disc.
  // roi2.w carries the ghost coverage cap in its MAGNITUDE and the contour flag in
  // its SIGN: <0 = GHOST+CONTOUR hybrid (faint Bayer stipple of the wall AND its
  // silhouette drawn as faint line-art — the dissolved wall's front face is
  // re-projected into posImg with w=2 for the tonemap pass); >0 = GHOST only. The
  // stipple lives purely in the COLOUR; the contour region is marked solid so its
  // outline stays clean instead of breaking up over the stipple. Enable: roi.w>0.
  bool roiContour = pc.roi2.w < 0.0;
  bool inContour = false;
  vec3 wallPos = vec3(0.0);
  if (pc.roi.w > 0.0) {
    float sd = distance(vec2(px) + vec2(0.5), pc.roi2.xy);
    float wv = (1.0 - smoothstep(pc.roi.w - max(pc.roi2.z, 1.0), pc.roi.w, sd)) * abs(pc.roi2.w);
    vec2 fwd = normalize(d.xz); // camera ground-forward (horizontal view dir)
    // Contour region: nearest hit is a FRONT occluder wall inside the disc (same
    // front-of-player gate as the dissolve loop), marked dissolved OR stipple-kept.
    if (roiContour && hitb && wv > 0.0 && (mats[h.mat].pad & 1) == 1
        && !(h.t > 0.6 && dot((o + d * h.t).xz - pc.roi.xyz.xz, fwd) >= 0.0)) {
      inContour = true;
      wallPos = o + d * h.t;
    }
    // Anchor the screen-door dither to the WORLD, not the player: project the
    // world origin to low-res px (the same iso::project_lowres mapping that placed
    // the disc centre) and key the Bayer lattice off it, so the stipple stays glued
    // to the scene as the player walks instead of riding along with them.
    vec3 orel = -pc.camPos.xyz;
    ivec2 wpx = ivec2((dot(orel, pc.camRight.xyz) / pc.camRight.w * 0.5 + 0.5) * float(W),
                      (0.5 - dot(orel, pc.camUp.xyz) / pc.camUp.w * 0.5) * float(H));
    if (wv > bayer4(px - wpx)) {
      for (int it = 0; it < 10 && hitb && (mats[h.mat].pad & 1) == 1; it++) {
        // Gate on the hit's FLOOR position, not its 3D view-depth: a plane
        // perpendicular to the tilted iso view dir slices a tall wall diagonally
        // by HEIGHT (its top sits at a smaller view-depth than its base), which
        // revealed the upper part of walls BEHIND the player. Comparing the XZ
        // footprint along the ground-forward axis keeps behind-player walls fully
        // solid regardless of height — only walls whose footprint is between the
        // camera and the player dissolve. Gate ONLY a FRESH occluder (a real ray
        // gap, h.t large): a hit within ~one slab thickness is the FAR FACE of the
        // wall we are already dissolving — pass it through, else its back face
        // (which sits right at the player's depth plane) is kept as a sliver.
        if (h.t > 0.6 && dot((o + d * h.t).xz - pc.roi.xyz.xz, fwd) >= 0.0) break;
        o = o + d * (h.t + (1.0 / 256.0));
        hitb = trace(o, d, 300.0, 0x01u, h);
      }
    }
  }
  // GLASS transmission (mats[..].pad bit 2 — the polana window panes): the
  // primary ray passes THROUGH tinted glass, multiplying the pane's base
  // colour into everything behind it — "black tinted but transparent"
  // (owner, 2026-07-12). One tint per pane: only ENTERING faces (raw normal
  // against the ray) count, the exit face passes free. Each entered pane
  // also adds the porcelain sheen — the sun key (same stylized specBRDF as
  // solid surfaces) plus a fresnel-weighted sky reflection — attenuated by
  // the panes already crossed. Shadow rays and the probe bake keep glass
  // OPAQUE (black glass blocks light like the wall it sits in), so this is
  // a camera-only effect and the GI/NEE double-count contract is untouched.
  // Deterministic: fixed loop, no randomness; scenes without glass never
  // enter the loop (pre-glass images are bit-identical).
  vec3 gtint = vec3(1.0);
  vec3 gsheen = vec3(0.0);
  for (int it = 0; it < 6 && hitb && (mats[h.mat].pad & 2) != 0; it++) {
    if (dot(h.n, d) < 0.0) { // entering face
      Material gm = mats[h.mat];
      if (pc.look.x > 0.0) {
        vec3 gp = o + d * h.t + h.n * 0.003;
        float greff = clamp(mix(gm.roughness, 0.12, pc.look.w), 0.10, 1.0);
        vec3 sheen = vec3(0.0);
        float gndl = max(dot(h.n, sunDir), 0.0);
        if (pc.env0.x > 0.0 && gndl > 0.0 && !occluded(gp, sunDir, 200.0))
          sheen += sun * pc.look.x * specBRDF(h.n, -d, sunDir, greff, vec3(0.04)) * gndl;
        float F = 0.04 + 0.96 * pow(1.0 - max(dot(h.n, -d), 0.0), 5.0);
        // fresnel SKY reflection: mirror the dome (|y|) — glass reflects
        // the sky, never the below-horizon void tint (a green void would
        // read as green glass, not black)
        vec3 rd = reflect(d, h.n);
        rd.y = abs(rd.y);
        sheen += sky(rd) * F * min(pc.look.x * 8.0, 1.0);
        gsheen += gtint * sheen;
      }
      gtint *= gm.baseColor.rgb;
    }
    o = o + d * (h.t + (1.0 / 256.0));
    hitb = trace(o, d, 300.0, 0x01u, h);
  }
  float tcam = hitb ? (h.t + dot(o - o0, d)) : 0.0; // camera→final-hit distance

  vec3 col;
  float fogT = 1.0;
  vec3 fogAdd = vec3(0.0);
  if (pc.env0.z > 0.0) {
    // exponential ground mist on the primary segment — fully analytic
    // (transmittance + ambient inscatter) plus ONE fixed-position sun-shaft
    // sample: deterministic, so it shades identically every frame.
    float tseg = hitb ? tcam : min(300.0, o0.y / max(-d.y, 1e-4));
    fogT = exp(-fogOD(o0, d, tseg));
    vec3 fogCol = vec3(0.55, 0.58, 0.66) * 0.18 * pc.env0.y;
    fogAdd = fogCol * (1.0 - fogT);
    if (pc.env0.x > 0.0) {
      float L = min(tseg, 8.0 * pc.env0.w / max(-d.y, 0.05));
      float ts = tseg - 0.5 * L;
      vec3 ps = o0 + d * ts;
      float ss = pc.env0.z * exp(-max(ps.y, 0.0) / pc.env0.w);
      if (ss > 1e-5 && !occluded(ps, sunDir, 200.0))
        fogAdd += sun * ss * exp(-fogOD(o0, d, ts)) * L * 0.08;
    }
  }

  if (!hitb) {
    col = (sky(d) * gtint + gsheen) * fogT + fogAdd;
    if (S > 0) { aaAccum(px, aaW, col); return; } // a tap that escapes IS coverage
    imageStore(albedoImg, px, vec4(gtint, 8.0)); // sky through glass demodulates tinted (a = the AA gate's "no edge")
    imageStore(posImg, px, inContour ? vec4(wallPos, 2.0) : vec4(0.0));
    imageStore(colorImg, px, vec4(col, 1.0));
    return;
  }

  Material m = mats[h.mat];
  vec3 albedo = m.baseColor.rgb;
  if (m.texIndex >= 0) albedo *= texture(textures[nonuniformEXT(m.texIndex)], h.uv).rgb;
  vec3 n = h.n; if (dot(n, d) > 0.0) n = -n;
  // the FLAT face normal, kept before wear/bump rewrite it: the contour-AA gate
  // converts an in-plane world distance to screen px through |n·d|, which is
  // only a bound for the real facet, not for a perturbed shading normal
  vec3 aaGn = n;
  // ---- procedural WEAR & TEAR on greybox walls/floors (flat-coloured, non-emissive):
  //   (1) mid-freq RELIEF perturbs the normal so light catches micro-unevenness;
  //   (2) broad worn ZONES + fine scuff + sparse SCRATCHES darken/desaturate albedo;
  //   (3) CONTACT grime cakes dirt into occluded corners/wall-bases (added once AO
  //       is known, below). Deterministic; only when BUMP>0 → goldens unchanged.
  //   Floors (n.y up) take more traffic than walls.
  vec3 wpos = o + h.t * d;
  bool greybox = pc.look.y > 0.0 && m.texIndex < 0 && dot(m.emissive.rgb, vec3(1.0)) <= 0.0;
  float wstr = pc.look.y;
  float floorw = 0.55 + 0.45 * clamp(n.y, 0.0, 1.0);
  if (greybox) {
    float freq = pc.look.z;
    // (1) relief → normal bump (small amplitude keeps slopes gentle)
    const float AMP = 0.045;
    float e = 0.5 / max(freq, 0.01);
    float h0 = fbm(wpos * freq);
    vec3 g = AMP * (vec3(fbm((wpos + vec3(e,0,0)) * freq),
                         fbm((wpos + vec3(0,e,0)) * freq),
                         fbm((wpos + vec3(0,0,e)) * freq)) - h0) / e;
    g = g - n * dot(g, n);
    n = normalize(n - wstr * g);
    floorw = 0.55 + 0.45 * clamp(n.y, 0.0, 1.0);
    // (2a) broad worn zones (low freq, squared → sparse darker patches) + fine scuff
    float broad = fbm(wpos * freq * 0.30 + 17.0);
    float fine  = fbm(wpos * freq * 2.30 + 41.0);
    float dirt = wstr * floorw * (0.40 * (1.0 - broad) * (1.0 - broad) + 0.10 * (1.0 - fine));
    // (2b) sparse SCRATCHES: thin streaks from axis-stretched value noise (two
    // directions); a tight smoothstep keeps them line-like, not a wash.
    float sc1 = vnoise(wpos * vec3(freq * 0.5, freq * 4.5, freq * 4.5) + 7.0);
    float sc2 = vnoise(wpos * vec3(freq * 4.5, freq * 4.5, freq * 0.5) + 23.0);
    float scratch = max(smoothstep(0.66, 0.78, sc1), smoothstep(0.66, 0.78, sc2));
    dirt += wstr * floorw * 0.22 * scratch;
    dirt = clamp(dirt, 0.0, 0.6);
    albedo *= 1.0 - dirt;
    albedo = mix(albedo, vec3(dot(albedo, vec3(0.299, 0.587, 0.114))), dirt * 0.5);
  }
  // ---- CRACK LAB (per-SEGMENT aging, owner knobs): Material.pad bits 8..31
  // carry four 6-bit unorm knobs — age / crack density / crack depth / chip —
  // packed by rt-viewer's crack::pad_bits (layout pinned by a CPU test; the
  // low bits 0..2 stay the occluder/glass/matte flags, bit 3 the selection
  // highlight below). Flat-coloured, non-emissive materials only; all-zero
  // knobs skip the whole block, so untouched scenes render bit-identically.
  //
  // Aging is HETEROGENEOUS (owner, 2026-07-23: uniform crazing reads fake).
  // Three layers, all pure functions of world position + the segment id
  // (h.mat — materials are per-pier 1:1, so it doubles as the seed that
  // keeps parallel walls from sharing one pattern):
  //  - a macro DAMAGE FIELD (low-freq fbm patches, damp rising at wall
  //    bases) gates cracks, crazing, chips and stains alike; AGE widens the
  //    patch threshold, so damage GROWS from the worst spots outward and a
  //    mid-aged wall stays mostly clean with a few bad corners;
  //  - the cellular network (dominant-axis face mapping — box UVs are dead
  //    on greyboxes) only crazes INSIDE damaged patches; the finer
  //    subdividing web only in the worst of them;
  //  - STRUCTURAL cracks are the cracks knob's primary meaning (faultAt):
  //    at most one full-height crack per ~6 wu strip — near-certain by
  //    mid-age at density >= ~0.45, a second offset lattice fading in at
  //    high density — that CROSSES the pier's top cap (same lattice keys
  //    on cap and faces): the single crack that divides a wall in two.
  //    Its lips bevel, its track stains, spall chips bite its edges.
  // DEPTH fakes relief three ways: darker groove floors, a fixed-view
  // parallax shift of the network (the ortho iso camera never moves, so
  // the shift is stable — grooves read sunk), and the edge bevels so
  // raking sun catches the lips. CHIP's chalky spall patches kill the
  // sheen (chipM feeds reff/spec below). Deterministic throughout.
  float chipM = 0.0;
  {
    uint kb = uint(m.pad);
    if ((kb >> 8) != 0u && m.texIndex < 0 && dot(m.emissive.rgb, vec3(1.0)) <= 0.0) {
      float cAge = float((kb >> 8) & 63u) * (1.0 / 63.0);
      float cDen = float((kb >> 14) & 63u) * (1.0 / 63.0);
      float cDep = float((kb >> 20) & 63u) * (1.0 / 63.0);
      float cChp = float((kb >> 26) & 63u) * (1.0 / 63.0);
      float seg = float(h.mat & 255) * 0.618; // per-segment seed
      vec3 an = abs(n);
      bool wallF = an.y <= 0.5;
      vec2 cuv = an.x > 0.5 ? wpos.zy : (an.y > 0.5 ? wpos.xz : wpos.xy);
      // fixed-view parallax: sample the network where the view ray meets the
      // groove floor (offset along the view dir projected onto the face)
      vec3 vt = d - n * dot(d, n);
      vec2 vuv = an.x > 0.5 ? vt.zy : (an.y > 0.5 ? vt.xz : vt.xy);
      vec2 cuvP = cuv + vuv * (0.08 * cDep / max(abs(dot(d, n)), 0.35));
      // macro damage field: where THIS segment is failing. Rising damp
      // lifts the base of walls into the patches. AGE slides one threshold
      // down the fbm range; the feature gates are STEEP slices around it
      // (fbm crowds its midrange — a soft window converges to uniform), so
      // even age=1 keeps most of the face clean: stains reach widest,
      // crazing needs solid damage, the fine web only the worst cores.
      float rise = wallF ? 1.0 - smoothstep(0.10, 1.0, cuv.y) : 0.0;
      float dmgN = fbm(vec3(cuv * vec2(0.45, 0.7), seg * 7.0 + 3.0)) + 0.16 * rise;
      float dT = mix(0.74, 0.55, cAge);
      float stainW = smoothstep(dT - 0.14, dT + 0.02, dmgN); // stains + chips
      float fineG = smoothstep(dT + 0.08, dT + 0.14, dmgN);  // fine web
      // STRUCTURAL cracks first (the cell network clusters along them) —
      // the cracks knob's PRIMARY meaning (owner, 2026-07-23: a structural
      // crack goes through the WHOLE wall; patches alone read fake). Wall
      // faces carry their face lattice plus a second, offset lattice that
      // fades in at high density (the wall going to pieces); pier top caps
      // evaluate BOTH orientation lattices with the same keys, so the
      // crack visibly crosses the cap — through the wall, not painted on.
      float mCore = 0.0, mHalo = 0.0;
      vec2 mBev = vec2(0.0);
      {
        float g2 = smoothstep(0.65, 0.95, cDen);
        float hl, sd, c;
        if (wallF) {
          c = faultAt(cuvP, seg, cAge, cDen, cDep, hl, sd);
          mCore = c; mHalo = hl; mBev.x = sd * hl * (1.0 - c);
          if (g2 > 0.0) {
            c = faultAt(cuvP + vec2(2.7, 0.0), seg + 130.0, cAge, cDen, cDep, hl, sd);
            c *= g2; hl *= g2;
            mCore = max(mCore, c); mHalo = max(mHalo, hl);
            mBev.x += sd * hl * (1.0 - c);
          }
        } else {
          c = faultAt(vec2(cuvP.x, wpos.y), seg, cAge, cDen, cDep, hl, sd);
          mCore = c; mHalo = hl; mBev.x = sd * hl * (1.0 - c);
          c = faultAt(vec2(cuvP.y, wpos.y), seg, cAge, cDen, cDep, hl, sd);
          mCore = max(mCore, c); mHalo = max(mHalo, hl);
          mBev.y = sd * hl * (1.0 - c);
          if (g2 > 0.0) {
            c = faultAt(vec2(cuvP.x + 2.7, wpos.y), seg + 130.0, cAge, cDen, cDep, hl, sd);
            c *= g2; hl *= g2;
            mCore = max(mCore, c); mHalo = max(mHalo, hl);
            mBev.x += sd * hl * (1.0 - c);
            c = faultAt(vec2(cuvP.y + 2.7, wpos.y), seg + 130.0, cAge, cDen, cDep, hl, sd);
            c *= g2; hl *= g2;
            mCore = max(mCore, c); mHalo = max(mHalo, hl);
            mBev.y += sd * hl * (1.0 - c);
          }
        }
      }
      // GEOMETRIC fault (pad bit 5, crack_geom.rs): the crack is a REAL
      // split — suppress the painted core + bevel, keep the halo so the
      // fracture crazing, stain track and spall chips hug the real seam.
      if ((kb & 32u) != 0u) { mCore = 0.0; mBev = vec2(0.0); }
      // CRAZE mode (pad bit 6, crack_geom.rs): the small-crack network is
      // real geometry — a pattern POLICY (lightning/craquelure/mosaic, host
      // side only) lays veneer fragments over a matte core, seams open as
      // >= 1 px grooves whose DEPTH the depth knob sets (owner round 5:
      // lighting/AO make the crack darkness, not paint). ALL the painted
      // cell work goes (lines, lips, line halos, chips — `show` zeroes
      // below); only the sub-pixel fine web + stains stay paint.
      bool crazeG = (kb & 64u) != 0u;
      float freqC = mix(1.1, 3.4, cDen);         // cells per wu
      float wdt = mix(0.02, 0.05, cDep) * freqC; // line half-width (cell units)
      vec2 site; float cellH;
      float edP = crackEdge(cuvP * freqC, seg + 5.0, site, cellH);
      // cells craze only where SOLIDLY damaged, or in the fault's fracture
      // zone (secondary cracks branching off the big one); age+density set
      // how many cells inside a zone actually let go
      float cover = mix(0.45, 0.9, cAge);
      float zone = max(smoothstep(dT + 0.02, dT + 0.08, dmgN), 0.5 * smoothstep(0.25, 0.90, mHalo));
      float show = step(cellH, cover) * zone;
      // geometry owns crack lines (owner round 5): craze piers replace the
      // cell network with policy fragments, FAULT piers drop it too (the
      // Worley web reads fake) — their small-crack detail is the real seam
      // + stains + fine web + spall chips hugging the lips.
      if ((kb & (32u | 64u)) != 0u) show = 0.0;
      float lineP = (1.0 - smoothstep(0.0, wdt, edP)) * show;
      // finer subdividing web only in the WORST patches
      vec2 siteF; float cellF;
      float edF = crackEdge(cuvP * freqC * 2.7 + 31.0, seg + 9.0, siteF, cellF);
      float fineW = (1.0 - smoothstep(0.0, wdt * 0.7, edF)) * step(cellF, cAge * 0.9) * fineG;
      float crack = max(max(lineP, fineW * 0.6 * smoothstep(0.15, 0.7, cAge)), mCore);
      albedo *= 1.0 - crack * (0.30 + 0.55 * cDep); // groove floor darkens
      albedo *= 1.0 - mCore * 0.55;                 // the fault core reads DEEP
      // edge bevel: tilt the normal back toward this pixel's own cell site
      // (away from the boundary) so the surface slopes down into the groove;
      // the fault adds its own lips (both sides tip away from the line)
      float lip = (1.0 - smoothstep(wdt, wdt * 3.0, edP)) * show;
      vec2 s2 = normalize(site + vec2(1e-5)) * (lip * cDep * 0.55);
      s2 += mBev * (0.20 + 0.45 * cDep);
      vec3 s3 = an.x > 0.5 ? vec3(0.0, s2.y, s2.x) : (an.y > 0.5 ? vec3(s2.x, 0.0, s2.y) : vec3(s2.x, s2.y, 0.0));
      s3 -= n * dot(s3, n);
      n = normalize(n + s3);
      // age: tea-stain blotches inside damaged patches + a stain halo
      // bleeding out of the cracks (the fault's water track stains hardest)
      float stain = fbm(wpos * 0.9 + 31.0);
      float halo = max((1.0 - smoothstep(0.0, wdt * 5.0, edP)) * show, mHalo * 0.85);
      float sAmt = cAge * clamp(0.55 * smoothstep(0.45, 0.85, stain) * (0.20 + 0.80 * stainW) + 0.35 * halo, 0.0, 1.0);
      albedo = mix(albedo, albedo * vec3(0.78, 0.70, 0.58), sAmt);
      // chip: chalky spall patches — glaze gone, matte body shows; clustered
      // in the damage patches and biting the fault's lips, never uniform
      float chpN = vnoise(wpos * 2.3 + 57.0);
      float chpEff = cChp * clamp(smoothstep(0.45, 0.85, stainW) + 0.9 * mHalo, 0.0, 1.0);
      chipM = smoothstep(mix(1.02, 0.50, chpEff), mix(1.10, 0.60, chpEff), chpN);
      chipM = max(chipM, (mHalo - mCore) * smoothstep(0.40, 0.75, chpN) * cChp);
      if (crazeG) chipM = 0.0; // chips are MISSING fragments, not paint
      float rim = smoothstep(0.02, 0.10, chipM) * (1.0 - smoothstep(0.55, 0.9, chipM));
      albedo = mix(albedo, albedo * 0.92 + vec3(0.05, 0.045, 0.035), chipM * 0.75);
      albedo *= 1.0 - rim * 0.35 * (0.4 + 0.6 * cDep);
    }
  }
  vec3 p = o + h.t * d + n * 0.003;
  // AO computed ONCE here, reused for contact grime + the indirect term below.
  float ao = 1.0;
  if (pc.camPos.w > 0.0 && pc.misc.z > 0 && pc.camDir.w > 0.0)
    ao = rtAO(p, n, pc.misc.z, pc.camDir.w, pc.camPos.w);
  // (3) CONTACT grime: dirt cakes into occluded crevices — corners, wall bases, the
  // player's contact shadow — driven by (1 - AO) with a warm-dark tint, greybox only.
  if (greybox) {
    float c = clamp((1.0 - ao) * 1.8 * wstr, 0.0, 1.0);
    albedo = mix(albedo, albedo * vec3(0.50, 0.47, 0.43), c * 0.7);
  }
  // ---- MATERIAL POSTERIZE (MATQ = look2.y >= 2): clamp the material's tonal
  // range — albedo snapped to N levels per channel, AFTER wear/grime so the
  // whole material tone is limited (roughness snaps below, at reff). The
  // quantized albedo feeds the G-buffer too, so tonemap's poster demodulation
  // stays consistent with what was actually lit.
  if (pc.look2.y >= 2.0) {
    float Lq = pc.look2.y - 1.0;
    albedo = floor(albedo * Lq + 0.5) / Lq;
  }
  // ---- DITHERED SHADOWS (AO_DITHER = look2.z > 0): the smooth RT-AO gradient
  // collapses to a binary per-pixel stipple — remap AO to its [1-strength, 1]
  // envelope, threshold against the ordered 4x4 Bayer, snap to floor or full.
  // Screen-anchored (ordered-dither shadows crawl under a pan — that IS the
  // look); applied AFTER contact grime, which wants the smooth term.
  if (pc.look2.z > 0.0 && pc.camPos.w > 0.0) {
    float aot = (ao - (1.0 - pc.camPos.w)) / max(pc.camPos.w, 1e-4);
    ao = aot >= bayer4(px) ? 1.0 : 1.0 - pc.camPos.w;
  }
  // crack-lab SELECTION highlight (pad bit 3): a steady amber lift on the
  // picked segment — constant (no pulse), so captures stay deterministic.
  if ((uint(m.pad) & 8u) != 0u) albedo = mix(albedo, vec3(1.0, 0.82, 0.40), 0.22);
  // .a = screen-px distance to the nearest gating triangle edge — the CONTOUR AA
  // gate (owner 2026-07-25); it was a constant 1.0 read by nobody (tonemap uses
  // .rgb only). An in-plane world distance foreshortens on screen by AT LEAST
  // |n·d| (the exact minimum over in-plane directions), so this is a
  // conservative LOWER bound: the gate may over-report a contour, never miss
  // one. 0.08 caps the correction at 12.5x on near-edge-on faces.
  float edgePx = min(h.edge * (0.5 * float(W) / pc.camRight.w) * max(abs(dot(aaGn, d)), 0.08), 8.0);
  if (S == 0) imageStore(albedoImg, px, vec4(albedo * gtint, edgePx)); // tint in the G-buffer keeps demodulation consistent
  // CONTOUR: re-project the dissolved wall's front face (w=2) so the tonemap outline
  // pass traces its silhouette as x-ray line-art; the radiance/albedo we store is
  // still the room BEHIND, so colour shows through while only the wall edges draw.
  if (S == 0) imageStore(posImg, px, inContour ? vec4(wallPos, 2.0) : vec4(o + h.t * d, 1.0));
  // DEBUG_AA (misc.w == 5): red = this texel would fire coverage taps, green
  // ramp = edgePx. The delicacy proof AND the cost measurement in one image.
  if (pc.misc.w == 5) {
    imageStore(colorImg, px, vec4(edgePx < 0.42 ? 1.0 : 0.0, min(edgePx, 4.0) * 0.25, 0.0, 1.0));
    return;
  }
  if (pc.misc.w == 1) { // debug: raw base colour
    imageStore(colorImg, px, vec4(albedo, 1.0));
    return;
  }
  if (pc.misc.w == 2) { // debug: probe GI only
    imageStore(colorImg, px, vec4(albedo * (1.0 / 3.14159265) * probeE(p, n), 1.0));
    return;
  }

  // ---- direct light: all deterministic ----
  col = m.emissive.rgb; // camera sees emitters

  // specular params (SPEC>0): effective roughness pulled toward polished by
  // GLOSS, dielectric F0 lerped to albedo by metallic. v points at the camera.
  // MATTE materials (pad bit 4 — grass floor/tufts) opt out of the whole
  // ceramic response: no gloss remap, no specular anywhere — the authored
  // roughness stands (grass never shines).
  vec3 vdir = -d;
  bool matte = (m.pad & 4) != 0;
  float reff = matte ? 1.0 : clamp(mix(m.roughness, 0.12, pc.look.w), 0.10, 1.0);
  // crack-lab CHIP: spalled patches lose the glaze — roughness climbs toward
  // matte and the specular gain dies down (chipM = 0 leaves both bit-exact).
  reff = clamp(reff + chipM * (1.0 - reff), 0.10, 1.0);
  float specX = pc.look.x * (1.0 - 0.85 * chipM);
  if (pc.look2.y >= 2.0) reff = clamp(floor(reff * 3.0 + 0.5) / 3.0, 0.10, 1.0); // MATQ: roughness in coarse steps too
  vec3 F0 = mix(vec3(0.04), albedo, m.metallic);

  float ndl = max(dot(n, sunDir), 0.0);
  if (pc.env0.x > 0.0 && ndl > 0.0 && !occluded(p, sunDir, 200.0)) {
    col += albedo * sun * ndl;
    if (pc.look.x > 0.0 && !matte) col += sun * specX * specBRDF(n, vdir, sunDir, reff, F0) * ndl;
  }

  int lc = pc.misc2.y;
  for (int li = 0; li < lc; li++) {
    Light lt = lights[li];
    vec3 toL = lt.posRad.xyz - p;
    float dist = max(length(toL), 1e-4);
    if (dist <= lt.posRad.w) continue;
    vec3 ldir = toL / dist;
    float ndl2 = dot(n, ldir);
    if (ndl2 <= 0.0) continue;
    float emit = 1.0;
    if (lt.dir.w == 2.0) {
      // spotlight (the player flashlight): color.w = cos(outer half-angle),
      // soft edge over the outer 40% of the cone
      float co = lt.color.w;
      emit = smoothstep(co, mix(co, 1.0, 0.6), dot(-ldir, lt.dir.xyz));
    } else if (lt.dir.w > 0.0) {
      emit = 2.0 * max(dot(-ldir, lt.dir.xyz), 0.0); // one-sided Lambertian (screens)
    }
    if (emit <= 0.0) continue;
    float sinT = clamp(lt.posRad.w / dist, 0.0, 1.0);
    float omega = 6.2831853 * (1.0 - sqrt(1.0 - sinT * sinT));
    vec3 c = albedo * (1.0 / 3.14159265) * lt.color.rgb * ndl2 * omega * emit;
    // contribution cull: skip the shadow ray when the unshadowed term is
    // already invisible — most pixels only pay for the 2-4 lights that matter
    if (max(c.r, max(c.g, c.b)) < 0.0015) continue;
    if (!occluded(p, ldir, dist - lt.posRad.w)) {
      col += c;
      if (pc.look.x > 0.0 && !matte) col += lt.color.rgb * emit * specX * specBRDF(n, vdir, ldir, reff, F0) * ndl2;
    }
  }

  // ---- indirect: world-space irradiance cache (debug 3: direct only), modulated
  // by the short-range RT-AO computed above (contact-scale occlusion the 0.5-wu
  // probe grid can't resolve). AO never touches direct light (the shadow rays are
  // already exact occlusion).
  if (pc.misc.w == 4) { // debug: AO term only
    imageStore(colorImg, px, vec4(vec3(ao), 1.0));
    return;
  }
  if (pc.misc.w != 3) col += albedo * (1.0 / 3.14159265) * probeE(p, n) * ao * pc.look2.x;

  // ---- PIXELATED REFLECTIONS (REFL = look2.w > 0): a mirror bounce rendered
  // at 1/REFL_PX resolution and composited over the full-res image. Every
  // pixel in a REFL_PX×REFL_PX screen block re-derives the BLOCK ANCHOR's
  // primary ray (ortho camera: same direction, shifted origin), so the whole
  // block computes one identical reflection — the same picture a low-res
  // reflection buffer + NEAREST upsample would give, without a second pass.
  // Floors and metals reflect; the bounce is shaded cheaply (emissive + sun
  // NEE + probe GI, no per-light loop) and added at knob strength — a
  // stylized wet-floor sheen, not PBR. REFL=0 skips every ray → goldens hold.
  // MATTE floors (grass) never turn into wet mirrors either.
  if (pc.look2.w > 0.0 && !matte && (m.metallic > 0.5 || n.y > 0.8)) {
    int B = max(pc.misc2.z, 1);
    ivec2 bp = (px / B) * B;
    float ub = ((float(bp.x) + 0.5 + TIE) / float(W)) * 2.0 - 1.0;
    float vb = -(((float(bp.y) + 0.5 + TIE) / float(H)) * 2.0 - 1.0);
    vec3 ob = pc.camPos.xyz + ub * pc.camRight.w * pc.camRight.xyz + vb * pc.camUp.w * pc.camUp.xyz;
    Hit bh;
    vec3 rc = vec3(0.0);
    if (trace(ob, d, 300.0, 0x01u, bh)) {
      vec3 bn = bh.n; if (dot(bn, d) > 0.0) bn = -bn;
      vec3 bpos = ob + d * bh.t + bn * 0.003;
      vec3 rdir = reflect(d, bn);
      Hit rh;
      // mask 0x05 (primary | dynamic): the player shows in the floor.
      if (trace(bpos, rdir, 60.0, 0x05u, rh)) {
        Material rm = mats[rh.mat];
        vec3 ralb = rm.baseColor.rgb;
        if (rm.texIndex >= 0) ralb *= texture(textures[nonuniformEXT(rm.texIndex)], rh.uv).rgb;
        vec3 rn = rh.n; if (dot(rn, rdir) > 0.0) rn = -rn;
        vec3 rp = bpos + rdir * rh.t + rn * 0.003;
        rc = rm.emissive.rgb;
        float rndl = max(dot(rn, sunDir), 0.0);
        if (pc.env0.x > 0.0 && rndl > 0.0 && !occluded(rp, sunDir, 200.0)) rc += ralb * sun * rndl;
        rc += ralb * (1.0 / 3.14159265) * probeE(rp, rn) * pc.look2.x;
      } else {
        rc = sky(rdir);
      }
    }
    col += rc * pc.look2.w;
  }

  col = (col * gtint + gsheen) * fogT + fogAdd;
  if (S > 0) aaAccum(px, aaW, col); else imageStore(colorImg, px, vec4(col, 1.0));
}
