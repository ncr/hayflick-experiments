{
  "name": "hayflick-26-2",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @apps/hub dev",
    "dev:s": "bash scripts/dev-https.sh",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:promoted": "pnpm --filter @common/gameplay test:coverage && pnpm --filter @common/level-editor test:coverage && pnpm --filter @common/physics-rapier test:coverage && pnpm --filter @common/collider-vhacd test:coverage",
    "test:e2e": "playwright test",
    "exp:new": "node scripts/new-experiment.mjs",
    "rebuild": "node scripts/blockstudio/rebuild-tileset.mjs",
    "rebuild:all": "for id in greek_island_white desert_sandstone ground_tiles; do node scripts/blockstudio/rebuild-tileset.mjs $id; done",
    "forge:retrofit-colliders": "pnpm --filter @apps/hub forge:retrofit-colliders",
    "forge:precompute-colliders": "pnpm --filter @apps/hub forge:precompute-colliders"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.1",
    "@types/three": "^0.173.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.20.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
