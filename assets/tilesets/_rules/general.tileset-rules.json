{
  "units": {
    "baseUnitCm": 128,
    "authoringUnitsPerBaseUnit": 128,
    "exporterScale": 128,
    "artifactFormat": "glb"
  },
  "render": {
    "projection": "ortho_iso_2_to_1",
    "gamePixelsPerBaseUnit": {
      "horizontal": 32,
      "vertical": 16
    },
    "densityAxis": "horizontal",
    "defaultDisplayScale": 2,
    "texturePixelsPerGamePixel": {
      "minimum": 1,
      "default": 2,
      "presets": [
        1,
        2,
        4
      ]
    }
  },
  "defaults": {
    "kind": "wall_kit",
    "wallSpan": 128,
    "wallHeight": 280,
    "wallThickness": 32,
    "floorThickness": 6,
    "door": {
      "width": 90,
      "height": 220,
      "frameThickness": 16,
      "frameProtrusion": 3
    },
    "window": {
      "narrowWidth": 32,
      "glassThickness": 4
    }
  },
  "requiredParts": {
    "wall_kit": [
      "wall",
      "corner",
      "window_left",
      "window_middle",
      "window_right",
      "door",
      "floor_tile"
    ]
  },
  "anchors": {
    "policy": "first_logical_unit",
    "snap": {
      "floor": "cell_center",
      "wall": "edge_midpoint",
      "corner": "vertex",
      "endCap": "edge_midpoint"
    },
    "articulation": {
      "hinged": "hinge_edge",
      "casement_window": "mounted_side"
    }
  },
  "notes": [
    "128cm is the holy logical base cell for the game grid.",
    "Walls and floors are plain butt joints — no chamfers, no mesh overlap.",
    "Multi-cell and multi-segment assets anchor to the first logical unit, never the geometric center."
  ]
